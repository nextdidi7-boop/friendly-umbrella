function library.create_tab(self, title)
	local tab_button = create_new('TextButton', {
		Name = title,
		BackgroundColor3 = VIREX_HOVER,
		BackgroundTransparency = 1,
		Size = _new_udim2(1, 0, 0, 32),
		Text = '',
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Parent = self._tabs_container,
	})

	create_round(tab_button, 7)

	create_label({
		Position = _new_udim2(0, 10, 0, 0),
		Size = _new_udim2(1, -20, 1, 0),
		Text = title,
		TextSize = self._label_text_size,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = tab_button,
	})

	local section = create_new('ScrollingFrame', {
		BackgroundTransparency = 1,
		Size = _new_udim2(1, -32, 1, -32),
		Position = _new_udim2(0, 16, 0, 16),
		CanvasSize = _new_udim2(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		Visible = false,
		Parent = self._sections,
	})

	section.ScrollBarThickness = 0
	create_vertical_list(section, 12)

	local tab_data = {
		_btn = tab_button,
		_section = section,
	}

	_insert(self._tabs, tab_data)

	if #self._tabs == 1 then
		section.Visible = true
		tab_button.BackgroundTransparency = 0
	end

	tab_button.MouseButton1Click:Connect(function()
		for _, t in self._tabs do
			t._section.Visible = false
			t._btn.BackgroundTransparency = 1
		end
		section.Visible = true
		tab_button.BackgroundTransparency = 0
	end)

	local group_manager = {}

	function group_manager:create_toggle(flag, values)
		local state = values.default or false

		local toggle_frame = create_new('Frame', {
			BackgroundTransparency = 1,
			Size = _new_udim2(1, 0, 0, 24),
			Parent = section,
		})

		local label = create_label({
			Size = _new_udim2(1, -40, 1, 0),
			Text = values.title,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = toggle_frame,
		})

		local switch = create_new('TextButton', {
			BackgroundColor3 = state and VIREX_ACCENT or Color3.fromRGB(40, 40, 40),
			AnchorPoint = _new_vector2(1, 0.5),
			Position = _new_udim2(1, 0, 0.5, 0),
			Size = _new_udim2(0, 30, 0, 18),
			Text = '',
			Parent = toggle_frame,
		})
		create_pill(switch)

		switch.MouseButton1Click:Connect(function()
			state = not state
			switch.BackgroundColor3 = state and VIREX_ACCENT or Color3.fromRGB(40, 40, 40)
			if values.callback then
				values.callback(state)
			end
		end)
	end

	function group_manager:create_slider(flag, values)
		local value = values.default or values.minimum

		local slider_frame = create_new('Frame', {
			BackgroundTransparency = 1,
			Size = _new_udim2(1, 0, 0, 30),
			Parent = section,
		})

		local label = create_label({
			Size = _new_udim2(1, -48, 0, 16),
			Text = values.title,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = slider_frame,
		})

		local val_label = create_label({
			Position = _new_udim2(1, -48, 0, 0),
			Size = _new_udim2(0, 48, 0, 16),
			Text = _tostring(value),
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = slider_frame,
		})

		local track = create_new('TextButton', {
			BackgroundColor3 = Color3.fromRGB(40, 40, 40),
			Position = _new_udim2(0, 0, 0, 18),
			Size = _new_udim2(1, 0, 0, 6),
			Text = '',
			Parent = slider_frame,
		})
		create_pill(track)

		local fill = create_new('Frame', {
			BackgroundColor3 = VIREX_ACCENT,
			Size = _new_udim2((value - values.minimum) / (values.maximum - values.minimum), 0, 1, 0),
			BorderSizePixel = 0,
			Parent = track,
		})
		create_pill(fill)

		local dragging = false

		local function update(input)
			local pos = _clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			value = round_number(values.minimum + (values.maximum - values.minimum) * pos, 0)
			val_label.Text = _tostring(value)
			fill.Size = _new_udim2(pos, 0, 1, 0)
			if values.callback then
				values.callback(value)
			end
		end

		track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				update(input)
			end
		end)

		user_input_service.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)

		user_input_service.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				update(input)
			end
		end)
	end

	return group_manager
end
