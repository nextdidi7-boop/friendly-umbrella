    if AutoHitEnabled then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(46, 204, 113) -- เปลี่ยนเป็นสีเขียว
        ToggleButton.Text = "AUTO HIT\n[ON]"
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(231, 76, 60) -- เปลี่ยนเป็นสีแดง
        ToggleButton.Text = "AUTO HIT\n[OFF]"
    end
end)

-- ระบบคลิกตีลูกอัตโนมัติลื่นไหลแบบ RenderStepped
RunService.RenderStepped:Connect(function()
    if AutoHitEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            
            -- ค้นหาลูกบอลในเกม
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") and (v.Name:lower():find("ball") or v.Name:lower():find("baseball")) then
                    local distance = (hrp.Position - v.Position).Magnitude
                    
                    -- ตรวจจับลูกบอลในระยะแล้วหวดทันที
                    if distance <= HitDistance then
                        VirtualUser:CaptureController()
                        VirtualUser:Button1Down(Vector2.new(0, 0))
                        task.wait()
                        VirtualUser:Button1Up(Vector2.new(0, 0))
                        break
                    end
                end
            end
        end
    end
end)

