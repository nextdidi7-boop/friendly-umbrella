local function setEnabled(state)
enabled = state

if enabled and root and root.Parent then  
    referenceY = root.Position.Y  
    targetY = referenceY - distance  
    root.CFrame = CFrame.new(  
        root.Position.X,  
        targetY,  
        root.Position.Z  
    )  
    toggle.BackgroundColor3 = GREEN  
    toggleKnob.Position = UDim2.new(1, -28, 0, 4)  
else  
    targetY = nil  
    referenceY = nil  
    toggle.BackgroundColor3 = GRAY  
    toggleKnob.Position = UDim2.fromOffset(4, 4)  
end

end

toggle.Activated:Connect(function()
setEnabled(not enabled)
end)

-- ล็อกระดับความสูงขณะเปิดระบบ
RunService.Heartbeat:Connect(function()
if enabled and targetY and root and root.Parent then
local pos = root.Position
if math.abs(pos.Y - targetY) > 0.1 then
root.CFrame = CFrame.new(pos.X, targetY, pos.Z)
end
end
end)

-- กด Z เพื่อเปิด/ปิดระบบ
UIS.InputBegan:Connect(function(input, processed)
if processed then return end
if input.KeyCode == Enum.KeyCode.Z then
setEnabled(not enabled)
end
end)

