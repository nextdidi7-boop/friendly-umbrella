function UpdateHitbox()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            if char and isAlive(char) and not isTeammate(p) then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not _G.OriginalSizes[hrp] then
                        _G.OriginalSizes[hrp] = {Size = hrp.Size, Transparency = hrp.Transparency, CanCollide = hrp.CanCollide}
                    end
                    if _G.HitboxEnabled then
                        hrp.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                        hrp.Transparency = 0.7
                        hrp.Color = Color3.fromRGB(255, 170, 0)
                        hrp.Material = Enum.Material.SmoothPlastic
                        hrp.CanCollide = false
                    else
                        if _G.OriginalSizes[hrp] then
                            hrp.Size = _G.OriginalSizes[hrp].Size
                            hrp.Transparency = _G.OriginalSizes[hrp].Transparency
                            hrp.CanCollide = _G.OriginalSizes[hrp].CanCollide
                        end
                    end
                end
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if not _G.ESP_NPC_ENABLED then
            for model, textObj in pairs(_G.NPC_CACHE) do pcall(function() textObj:Remove() end) end
            _G.NPC_CACHE = {}
        else
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                    local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                    if hrp then
                        if not _G.NPC_CACHE[obj] then
                            local t = Drawing.new("Text")
                            t.Center = true
                            t.Outline = true
                            t.Font = 2
                            t.Size = 13
                            t.Color = Color3.fromRGB(0, 255, 150)
                            _G.NPC_CACHE[obj] = t
                        end

                        local pos, on = Camera:WorldToViewportPoint(hrp.Position)
                        if on then
                            _G.NPC_CACHE[obj].Text = "[NPC] " .. obj.Name
                            _G.NPC_CACHE[obj].Position = Vector2.new(pos.X, pos.Y - 20)
                            _G.NPC_CACHE[obj].Visible = true
                        else
                            _G.NPC_CACHE[obj].Visible = false
                        end
                    end
                end
            end
        end
    end
end)

function joinLowPlayerServer()
    local api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(api)) end)
    if success and result and result.data then
        for _, server in ipairs(result.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                break
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    FOVCircle.Position = center
    FOVCircle.Radius = _G.FOV
    FOVCircle.Visible = _G.SilentAim or _G.CAMERA_LOCK

    AimLine.Visible = false
    _G.CurrentTarget = nil

    if _G.SilentAim or _G.CAMERA_LOCK then _G.CurrentTarget = getTarget() end
    if _G.CAMERA_LOCK and _G.CurrentTarget then cameraLookAt(_G.CurrentTarget) end

    if _G.SilentAim and not _G.CAMERA_LOCK and _G.CurrentTarget then
        local p = Camera:WorldToViewportPoint(_G.CurrentTarget.Position)
        AimLine.From = center
        AimLine.To = Vector2.new(p.X,p.Y)
        AimLine.Visible = true
    end

    ESP_SYSTEM()
    RAINBOW_ESP_SYSTEM()

    for char,_ in pairs(_G.ESP_CACHE) do if not isCharValid(char) then clearESP(char) end end
    for char,_ in pairs(_G.HIGHLIGHT_CACHE) do if not isCharValid(char) then clearHighlight(char) end end

    if _G.WalkSpeedEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = _G.WalkSpeedVal end
    end

    if _G.FullbrightEnabled then
        Lighting.Brightness = _G.BrightnessVal
        Lighting.ClockTime = 12
    end
end)
