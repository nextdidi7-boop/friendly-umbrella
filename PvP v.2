--------------------------------------------------
-- Utility & Core Logic Functions
--------------------------------------------------
local function isAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isTeammate(p)
    if not _G.TeamCheck then return false end
    if not LocalPlayer.Team or not p.Team then return false end
    return p.Team == LocalPlayer.Team
end

local function rainbowColor(speed)
    local t = tick() * speed
    return Color3.fromHSV(t % 1, 1, 1)
end

local function isCharValid(char)
    return char and char.Parent and char:IsDescendantOf(workspace)
end

local function cameraLookAt(part)
    if not part then return end
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
end

-- Rapid Fire & Burst Fire Logic
task.spawn(function()
    while true do
        task.wait(_G.RapidFireDelay)
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    if _G.BurstFireEnabled then
                        pcall(function()
                            tool:Activate()
                            task.wait(0.05)
                            tool:Activate()
                        end)
                        task.wait(0.15)
                    elseif _G.RapidFireEnabled then
                        pcall(function()
                            tool:Activate()
                        end)
                    end
                end
            end
        end
    end
end)

-- Auto Counter-Fire System
local function TriggerRetaliation()
    if not _G.AutoCounterEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end

    local closest, attacker = math.huge, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not isTeammate(p) then
            local pChar = p.Character
            if pChar and isAlive(pChar) then
                local head = pChar:FindFirstChild("Head")
                local hrp = pChar:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (char.HumanoidRootPart.Position - hrp.Position).Magnitude
                    if dist < closest then
                        closest = dist
                        attacker = head or hrp
                    end
                end
            end
        end
    end

    if attacker then
        cameraLookAt(attacker)
        task.spawn(function()
            for i = 1, 10 do
                if not isAlive(char) then break end
                cameraLookAt(attacker)
                pcall(function() tool:Activate() end)
                task.wait(0.02)
            end
        end)
    end
end

local function BindHealthCheck(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        LastHealth = hum.Health
        hum.HealthChanged:Connect(function(newHealth)
            if newHealth < LastHealth then
                TriggerRetaliation()
            end
            LastHealth = newHealth
        end)
    end
end

if LocalPlayer.Character then BindHealthCheck(LocalPlayer.Character) end

-- Boob Physics Engine
function DestroyBoobs()
    for _, v in ipairs(CreatedBoobParts) do
        if v and v.Parent then pcall(function() v:Destroy() end) end
    end
    CreatedBoobParts = {}
    LeftMeshWeld, RightMeshWeld = nil, nil
end

function BuildSoftBoob(char)
    DestroyBoobs()
    if not char or not char.Parent then return end
    
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local head = char:FindFirstChild("Head")
    if not torso then return end
    
    local skinCol = head and head.Color or torso.Color
    local pink1 = Color3.fromRGB(255, 130, 155)
    local pink2 = Color3.fromRGB(255, 80, 120)
    local s = _G.BoobSettings.Size

    local function createSphere(cf, size, col, parentWeld)
        local p = Instance.new("Part")
        p.Shape = Enum.PartType.Ball
        p.Size = size
        p.Color = col
        p.Material = Enum.Material.SmoothPlastic
        p.CanCollide = false
        p.Massless = true
        p.Parent = char

        local w = Instance.new("Weld")
        w.Part0 = parentWeld or torso
        w.Part1 = p
        w.C0 = cf
        w.Parent = p
        
        table.insert(CreatedBoobParts, p)
        return p, w
    end

    local lMain, lW = createSphere(BaseLeftC0, Vector3.new(1.05 * s, 1.25 * s, 1.15 * s), skinCol)
    local rMain, rW = createSphere(BaseRightC0, Vector3.new(1.05 * s, 1.25 * s, 1.15 * s), skinCol)
    LeftMeshWeld = lW
    RightMeshWeld = rW

    createSphere(CFrame.new(0, -0.18 * s, 0.08 * s), Vector3.new(0.95 * s, 0.95 * s, 1.05 * s), skinCol, lMain)
    createSphere(CFrame.new(0, -0.18 * s, 0.08 * s), Vector3.new(0.95 * s, 0.95 * s, 1.05 * s), skinCol, rMain)

    createSphere(CFrame.new(0, -0.02 * s, -0.55 * s), Vector3.new(0.38 * s, 0.38 * s, 0.08 * s), pink1, lMain)
    createSphere(CFrame.new(0, -0.02 * s, -0.55 * s), Vector3.new(0.38 * s, 0.38 * s, 0.08 * s), pink1, rMain)
    createSphere(CFrame.new(0, -0.02 * s, -0.58 * s), Vector3.new(0.15 * s, 0.15 * s, 0.1 * s), pink2, lMain)
    createSphere(CFrame.new(0, -0.02 * s, -0.58 * s), Vector3.new(0.15 * s, 0.15 * s, 0.1 * s), pink2, rMain)
end

RunService.Heartbeat:Connect(function(dt)
    if _G.BoobSettings.Enabled and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and LeftMeshWeld and RightMeshWeld then
            local pos = hrp.Position
            if LastHRPPos then
                local delta = (pos - LastHRPPos)
                local moveVel = hrp.CFrame:VectorToObjectSpace(delta / dt)
                
                local targetOff = Vector3.new(
                    math.clamp(-moveVel.X * 0.02, -0.4, 0.4),
                    math.clamp(-moveVel.Y * 0.03, -0.5, 0.5),
                    math.clamp(moveVel.Z * 0.02, -0.3, 0.3)
                )

                local force = (targetOff - PhysPos) * _G.BoobSettings.Stiffness
                PhysVel = (PhysVel + force * dt) * (1 - math.clamp(_G.BoobSettings.Damping, 0, 1))
                PhysPos = PhysPos + PhysVel * dt
            end
            LastHRPPos = pos

            LeftMeshWeld.C0 = BaseLeftC0 * CFrame.new(PhysPos) * CFrame.Angles(PhysPos.Y * 0.9, -PhysPos.X * 0.8, PhysPos.X * 0.4)
            RightMeshWeld.C0 = BaseRightC0 * CFrame.new(PhysPos) * CFrame.Angles(PhysPos.Y * 0.9, PhysPos.X * 0.8, -PhysPos.X * 0.4)
        end
    else
        LastHRPPos = nil
    end
end)

-- Aim & ESP Mechanics
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Blacklist
RayParams.IgnoreWater = true

local function isVisible(part, char)
    RayParams.FilterDescendantsInstances = {LocalPlayer.Character, char}
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    return not workspace:Raycast(origin, dir, RayParams)
end

local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 2
FOVCircle.Filled = false
FOVCircle.Color = Color3.fromRGB(255,255,0)

local AimLine = Drawing.new("Line")
AimLine.Thickness = 2
AimLine.Color = Color3.fromRGB(255,0,0)

local function clearHighlight(char)
    if _G.HIGHLIGHT_CACHE[char] then
        pcall(function() _G.HIGHLIGHT_CACHE[char]:Destroy() end)
        _G.HIGHLIGHT_CACHE[char] = nil
    end
end

local function clearESP(char)
    local cache = _G.ESP_CACHE[char]
    if cache then
        pcall(function()
            if cache.Text then
                cache.Text.Visible = false
                cache.Text:Remove()
            end
        end)
        _G.ESP_CACHE[char] = nil
    end
    clearHighlight(char)
end

local function ESP_SYSTEM()
    if not _G.ESP_ENABLED then
        for char,_ in pairs(_G.ESP_CACHE) do clearESP(char) end
        return
    end

    for _,p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if p ~= LocalPlayer and char and isCharValid(char) and isAlive(char) and not isTeammate(p) then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then clearESP(char) continue end

            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            if dist > _G.MaxDistance then
                if _G.ESP_CACHE[char] then _G.ESP_CACHE[char].Text.Visible = false end
                continue
            end

            if not _G.ESP_CACHE[char] then
                local t = Drawing.new("Text")
                t.Center = true
                t.Outline = true
                t.Font = 2
                t.Size = 14
                _G.ESP_CACHE[char] = {Text = t}
            end

            local txt = _G.ESP_CACHE[char].Text
            local pos, on = Camera:WorldToViewportPoint(hrp.Position)
            if on then
                txt.Text = p.Name.." ["..math.floor(dist).."m]"
                txt.Position = Vector2.new(pos.X, pos.Y - 28)
                txt.Color = (_G.CurrentTarget and _G.CurrentTarget:IsDescendantOf(char)) and Color3.fromRGB(255,60,60) or Color3.fromRGB(255,255,255)
                txt.Visible = true
            else
                txt.Visible = false
            end
        else
            if char then clearESP(char) end
        end
    end
end

local function RAINBOW_ESP_SYSTEM()
    if not _G.RAINBOW_ESP then
        for char,_ in pairs(_G.HIGHLIGHT_CACHE) do clearHighlight(char) end
        return
    end

    for _,p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if p ~= LocalPlayer and char and isCharValid(char) and isAlive(char) and not isTeammate(p) then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp or (Camera.CFrame.Position - hrp.Position).Magnitude > _G.MaxDistance then
                clearHighlight(char)
                continue
            end

            if not _G.HIGHLIGHT_CACHE[char] then
                local h = Instance.new("Highlight")
                h.Adornee = char
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.FillTransparency = 1
                h.OutlineTransparency = 0
                h.Parent = workspace
                _G.HIGHLIGHT_CACHE[char] = h
            end
            _G.HIGHLIGHT_CACHE[char].OutlineColor = rainbowColor(0.25)
        else
            if char then clearHighlight(char) end
        end
    end
end

local function getTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local closest, target = math.huge, nil

    for _,p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if p ~= LocalPlayer and char and isAlive(char) and not isTeammate(p) then
            local targetPart = char:FindFirstChild(_G.TargetPartName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            local hrp  = char:FindFirstChild("HumanoidRootPart")
            if targetPart and hrp and (Camera.CFrame.Position - hrp.Position).Magnitude <= _G.MaxDistance and isVisible(targetPart, char) then
                local s,on = Camera:WorldToViewportPoint(targetPart.Position)
                if on then
                    local d = (Vector2.new(s.X,s.Y) - center).Magnitude
                    if d < _G.FOV and d < closest then
                        closest, target = d, targetPart
                    end
                end
            end
        end
    end
    return target
end

