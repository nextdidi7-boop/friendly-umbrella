        _G.CurrentTarget = _G.getTarget()
        if _G.CurrentTarget then
            _G.cameraLookAt(_G.CurrentTarget)
            local p = Camera:WorldToViewportPoint(_G.CurrentTarget.Position)
            AimLine.From = center
            AimLine.To = Vector2.new(p.X, p.Y)
            AimLine.Visible = true
        end
    end
end)
