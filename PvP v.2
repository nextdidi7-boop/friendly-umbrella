--[[
    Dolly Hub - Complete Script
    PART 1/3: Core Services, States & Weapon Systems
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- Load WindUI Library
--------------------------------------------------
local WindUI
local successLoad, err = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
end)

if not successLoad or not WindUI then
    warn("Failed to load WindUI: ", err)
    return
end

--------------------------------------------------
-- Global States & Settings
--------------------------------------------------
local CAMERA_LOCK = false
local ESP_ENABLED = false
local TeamCheck = true
local MaxDistance = 600
local FOV = 200

local RapidFireEnabled = false
local RapidFireDelay = 0.01
local BurstFireEnabled = false
local AutoCounterEnabled = false

local LastHealth = 100
local CurrentTarget = nil
local TargetPartName = "Head"

--------------------------------------------------
-- Helper Functions
--------------------------------------------------
local function isAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isTeammate(p)
    if not TeamCheck then return false end
    if not LocalPlayer.Team or not p.Team then return false end
    return p.Team == LocalPlayer.Team
end

local function cameraLookAt(part)
    if not part then return end
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
end

--------------------------------------------------
-- Weapon Mechanics (Rapid / Burst / Counter)
--------------------------------------------------
task.spawn(function()
    while true do
        task.wait(RapidFireDelay)
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    if BurstFireEnabled then
                        pcall(function()
                            tool:Activate()
                            task.wait(0.05)
                            tool:Activate()
                        end)
                        task.wait(0.15)
                    elseif RapidFireEnabled then
                        pcall(function()
                            tool:Activate()
                        end)
                    end
                end
            end
        end
    end
end)

local function TriggerRetaliation()
    if not AutoCounterEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end

    local closest, attacker = math.huge, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not isTeammate(p) then
            local pChar = p.Character
            if pChar and isAlive(pChar) then
                local head = pChar:FindFirstChild("Head")
                local hrp = pChar:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (char.HumanoidRootPart.Position - hrp.Position).Magnitude
                    if dist < closest then
                        closest = dist
                        attacker = head or hrp
                    end
                end
            end
        end
    end

    if attacker then
        cameraLookAt(attacker)
        task.spawn(function()
            for i = 1, 10 do
                if not isAlive(char) then break end
                cameraLookAt(attacker)
                pcall(function() tool:Activate() end)
                task.wait(0.02)
            end
        end)
    end
end

local function BindHealthCheck(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        LastHealth = hum.Health
        hum.HealthChanged:Connect(function(newHealth)
            if newHealth < LastHealth then
                TriggerRetaliation()
            end
            LastHealth = newHealth
        end)
    end
end

if LocalPlayer.Character then BindHealthCheck(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(char)
    BindHealthCheck(char)
end)
--[[
    Dolly Hub - Complete Script
    PART 2/3: Visual Elements & Target Acquisition Loop
]]

--------------------------------------------------
-- Drawing & Visuals Setup
--------------------------------------------------
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 2
FOVCircle.Filled = false
FOVCircle.Color = Color3.fromRGB(255, 255, 0)

local AimLine = Drawing.new("Line")
AimLine.Thickness = 2
AimLine.Color = Color3.fromRGB(255, 0, 0)

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Blacklist
RayParams.IgnoreWater = true

local function isVisible(part, char)
    RayParams.FilterDescendantsInstances = {LocalPlayer.Character, char}
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    return not workspace:Raycast(origin, dir, RayParams)
end

local function getTarget()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest, target = math.huge, nil

    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if p ~= LocalPlayer and char and isAlive(char) and not isTeammate(p) then
            local targetPart = char:FindFirstChild(TargetPartName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if targetPart and hrp and (Camera.CFrame.Position - hrp.Position).Magnitude <= MaxDistance and isVisible(targetPart, char) then
                local s, on = Camera:WorldToViewportPoint(targetPart.Position)
                if on then
                    local d = (Vector2.new(s.X, s.Y) - center).Magnitude
                    if d < FOV and d < closest then
                        closest, target = d, targetPart
                    end
                end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    FOVCircle.Position = center
    FOVCircle.Radius = FOV
    FOVCircle.Visible = CAMERA_LOCK

    AimLine.Visible = false
    CurrentTarget = nil

    if CAMERA_LOCK then 
        CurrentTarget = getTarget() 
    end
    
    if CAMERA_LOCK and CurrentTarget then 
        cameraLookAt(CurrentTarget)
        local p = Camera:WorldToViewportPoint(CurrentTarget.Position)
        AimLine.From = center
        AimLine.To = Vector2.new(p.X, p.Y)
        AimLine.Visible = true
    end
end)
--[[
    Dolly Hub - Complete Script
    PART 3/3: WindUI Controls Setup
]]

--------------------------------------------------
-- UI Interface Construction
--------------------------------------------------
local Window = WindUI:CreateWindow({
    Title = "Dolly Hub",
    Subtitle = "นึกถึงสคริปต์ที่ดีที่สุด",
    Folder = "DollyHub",
    OpenButton = {Title = "Dolly Hub", Enabled = true}
})

local AimbotTab = Window:Tab({Title = "Aimbot", Icon = "crosshair"})

AimbotTab:Section({ Title = "Aimbot Settings" })

AimbotTab:Toggle({
    Title = "ล็อคหัว (Aimbot)",
    Default = CAMERA_LOCK,
    Callback = function(v) CAMERA_LOCK = v end
})

AimbotTab:Dropdown({
    Title = "เลือกส่วนที่จะยิง",
    Values = {"ศีรษะ", "ลำตัว"},
    Default = "ศีรษะ",
    Callback = function(v)
        TargetPartName = (v == "ศีรษะ") and "Head" or "HumanoidRootPart"
    end
})

AimbotTab:Slider({
    Title = "ขนาด FOV",
    Value = {Min = 40, Max = 1000, Default = FOV},
    Callback = function(v) FOV = v end
})

AimbotTab:Section({ Title = "Gun Modifies" })

AimbotTab:Toggle({
    Title = "ยิงทีละ 2 นัด (Burst Fire)",
    Default = BurstFireEnabled,
    Callback = function(v)
        BurstFireEnabled = v
        if v then RapidFireEnabled = false end
    end
})

AimbotTab:Toggle({
    Title = "ยิงโต้กลับอัตโนมัติ (Auto Counter-Fire)",
    Default = AutoCounterEnabled,
    Callback = function(v) AutoCounterEnabled = v end
})

AimbotTab:Toggle({
    Title = "ยิงรัว (Rapid Fire)",
    Default = RapidFireEnabled,
    Callback = function(v)
        RapidFireEnabled = v
        if v then BurstFireEnabled = false end
    end
})
