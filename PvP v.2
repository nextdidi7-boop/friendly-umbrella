--------------------------------------------------
-- Target Acquisition Engine
--------------------------------------------------
function _G.getTarget()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest, target = math.huge, nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            if char and _G.isAlive(char) then
                local targetPart = char:FindFirstChild(_G.TargetPartName) or char:FindFirstChild("Head")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if targetPart and hrp and (Camera.CFrame.Position - hrp.Position).Magnitude <= _G.MaxDistance then
                    local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if dist < _G.FOV and dist < closest then
                            closest = dist
                            target = targetPart
                        end
                    end
                end
            end
        end
    end
    return target
end

