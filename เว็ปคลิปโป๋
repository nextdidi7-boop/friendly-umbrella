require('dotenv').config();
const express = require('express');
const jwt = require('jsonwebtoken');
const bcrypt = require('bcryptjs');
const multer = require('multer');
const sqlite3 = require('sqlite3').verbose();
const path = require('path');
const fs = require('fs');

const app = express();
app.use(express.json());

// สร้างโฟลเดอร์สำหรับเก็บไฟล์วิดีโออัปโหลด
const uploadDir = path.join(__dirname, 'uploads');
if (!fs.existsSync(uploadDir)) {
    fs.mkdirSync(uploadDir);
}

// --------------------------------------------------
// 1. ตั้งค่า Database (SQLite)
// --------------------------------------------------
const db = new sqlite3.Database('./video_platform.db', (err) => {
    if (err) console.error('Database connection error:', err);
    else console.log('Connected to SQLite database.');
});

db.serialize(() => {
    // ตาราง Users
    db.run(`
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE NOT NULL,
            password TEXT NOT NULL,
            role TEXT NOT NULL DEFAULT 'user'
        )
    `);

    // ตาราง Videos
    db.run(`
        CREATE TABLE IF NOT EXISTS videos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            title TEXT NOT NULL,
            description TEXT,
            filename TEXT NOT NULL,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP
        )
    `);

    // สร้าง Admin เริ่มต้น (Username: admin, Password: adminpassword)
    const adminUser = 'admin';
    const adminPass = 'adminpassword';
    db.get(`SELECT id FROM users WHERE username = ?`, [adminUser], (err, row) => {
        if (!row) {
            const hash = bcrypt.hashSync(adminPass, 10);
            db.run(`INSERT INTO users (username, password, role) VALUES (?, ?, ?)`, [adminUser, hash, 'admin']);
            console.log('-------------------------------------------');
            console.log('สร้างบัญชี Admin เริ่มต้นเรียบร้อย!');
            console.log(`Username: ${adminUser}`);
            console.log(`Password: ${adminPass}`);
            console.log('-------------------------------------------');
        }
    });
});

app.use('/uploads', express.static(uploadDir));

// --------------------------------------------------
// 2. ตั้งค่า Multer (จัดเก็บไฟล์ลงดิสก์)
// --------------------------------------------------
const storage = multer.diskStorage({
    destination: (req, file, cb) => cb(null, uploadDir),
    filename: (req, file, cb) => {
        const uniqueSuffix = Date.now() + '-' + Math.round(Math.random() * 1E9);
        const ext = path.extname(file.originalname);
        cb(null, 'video-' + uniqueSuffix + ext);
    }
});

const upload = multer({
    storage: storage,
    fileFilter: (req, file, cb) => {
        if (file.mimetype.startsWith('video/')) cb(null, true);
        else cb(new Error('อนุญาตเฉพาะไฟล์วิดีโอเท่านั้น'), false);
    }
});

// --------------------------------------------------
// 3. Middleware ตรวจสอบสิทธิ์ Admin
// --------------------------------------------------
const verifyAdmin = (req, res, next) => {
    const authHeader = req.headers['authorization'];
    const token = authHeader && authHeader.split(' ')[1];

    if (!token) return res.status(401).json({ message: 'กรุณาเข้าสู่ระบบก่อน' });

    jwt.verify(token, process.env.JWT_SECRET || 'fallback_secret', (err, decoded) => {
        if (err || decoded.role !== 'admin') {
            return res.status(403).json({ message: 'สิทธิ์ไม่ถูกต้อง (สำหรับ Admin เท่านั้น)' });
        }
        req.user = decoded;
        next();
    });
};

// --------------------------------------------------
// 4. API Endpoints
// --------------------------------------------------

// [POST] ล็อกอิน Admin
app.post('/api/login', (req, res) => {
    const { username, password } = req.body;
    db.get(`SELECT * FROM users WHERE username = ?`, [username], (err, user) => {
        if (err) return res.status(500).json({ error: err.message });
        if (!user) return res.status(400).json({ message: 'ไม่พบบัญชีผู้ใช้นี้' });

        const isMatch = bcrypt.compareSync(password, user.password);
        if (!isMatch) return res.status(400).json({ message: 'รหัสผ่านไม่ถูกต้อง' });

        const token = jwt.sign(
            { id: user.id, username: user.username, role: user.role },
            process.env.JWT_SECRET || 'fallback_secret',
            { expiresIn: '1d' }
        );

        res.json({ message: 'เข้าสู่ระบบสำเร็จ', token, role: user.role });
    });
});

// [GET] ดึงวิดีโอทั้งหมด
app.get('/api/videos', (req, res) => {
    db.all(`SELECT * FROM videos ORDER BY created_at DESC`, [], (err, rows) => {
        if (err) return res.status(500).json({ error: err.message });
        const videos = rows.map(v => ({
            id: v.id,
            title: v.title,
            description: v.description,
            video_url: `/uploads/${v.filename}`,
            created_at: v.created_at
        }));
        res.json(videos);
    });
});

// [POST] เพิ่มวิดีโอใหม่ (เฉพาะ Admin)
app.post('/api/videos', verifyAdmin, upload.single('video'), (req, res) => {
    if (!req.file) return res.status(400).json({ message: 'กรุณาแนบไฟล์วิดีโอ' });
    const { title, description } = req.body;
    const filename = req.file.filename;

    db.run(`INSERT INTO videos (title, description, filename) VALUES (?, ?, ?)`,
        [title || req.file.originalname, description || '', filename],
        function (err) {
            if (err) return res.status(500).json({ error: err.message });
            res.status(201).json({ message: 'เพิ่มวิดีโอสำเร็จ', videoId: this.lastID });
        }
    );
});

// [PUT] แก้ไขชื่อและรายละเอียดวิดีโอ (เฉพาะ Admin)
app.put('/api/videos/:id', verifyAdmin, (req, res) => {
    const videoId = req.params.id;
    const { title, description } = req.body;

    db.run(`UPDATE videos SET title = ?, description = ? WHERE id = ?`,
        [title, description, videoId],
        function (err) {
            if (err) return res.status(500).json({ error: err.message });
            if (this.changes === 0) return res.status(404).json({ message: 'ไม่พบวิดีโอนี้' });
            res.json({ message: 'แก้ไขข้อมูลวิดีโอสำเร็จ' });
        }
    );
});

// [DELETE] ลบวิดีโอ (เฉพาะ Admin)
app.delete('/api/videos/:id', verifyAdmin, (req, res) => {
    const videoId = req.params.id;
    db.get(`SELECT filename FROM videos WHERE id = ?`, [videoId], (err, row) => {
        if (err) return res.status(500).json({ error: err.message });
        if (!row) return res.status(404).json({ message: 'ไม่พบวิดีโอนี้' });

        const filePath = path.join(uploadDir, row.filename);
        fs.unlink(filePath, () => {
            db.run(`DELETE FROM videos WHERE id = ?`, [videoId], (dbErr) => {
                if (dbErr) return res.status(500).json({ error: dbErr.message });
                res.json({ message: 'ลบวิดีโอเรียบร้อยแล้ว' });
            });
        });
    });
});

