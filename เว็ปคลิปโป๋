require('dotenv').config();
const express = require('express');
const jwt = require('jsonwebtoken');
const bcrypt = require('bcryptjs');
const multer = require('multer');
const sqlite3 = require('sqlite3').verbose();
const path = require('path');
const fs = require('fs');

const app = express();
app.use(express.json());

// สร้างโฟลเดอร์ uploads อัตโนมัติหากยังไม่มี
const uploadDir = path.join(__dirname, 'uploads');
if (!fs.existsSync(uploadDir)) {
    fs.mkdirSync(uploadDir, { recursive: true });
}

// --------------------------------------------------
// 1. ตั้งค่า Database (SQLite)
// --------------------------------------------------
const db = new sqlite3.Database('./video_platform.db', (err) => {
    if (err) console.error('Database connection error:', err);
    else console.log('Connected to SQLite database.');
});

// สร้างตารางและสร้างบัญชี Admin เริ่มต้น
db.serialize(() => {
    db.run(`
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE NOT NULL,
            password TEXT NOT NULL,
            role TEXT NOT NULL DEFAULT 'user'
        )
    `);

    db.run(`
        CREATE TABLE IF NOT EXISTS videos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            title TEXT NOT NULL,
            description TEXT,
            filename TEXT NOT NULL,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP
        )
    `);

    const adminUser = 'admin';
    const adminPass = 'adminpassword';
    
    db.get(`SELECT id FROM users WHERE username = ?`, [adminUser], (err, row) => {
        if (!row) {
            const hash = bcrypt.hashSync(adminPass, 10);
            db.run(`INSERT INTO users (username, password, role) VALUES (?, ?, ?)`, [adminUser, hash, 'admin']);
            console.log('--- Admin Account Created ---');
            console.log(`Username: ${adminUser}`);
            console.log(`Password: ${adminPass}`);
            console.log('----------------------------');
        }
    });
});

// เปิดให้เข้าถึงไฟล์วิดีโอผ่าน URL
app.use('/uploads', express.static(uploadDir));

// --------------------------------------------------
// 2. ตั้งค่า Multer (จัดเก็บไฟล์ลงเครื่อง)
// --------------------------------------------------
const storage = multer.diskStorage({
    destination: (req, file, cb) => cb(null, uploadDir),
    filename: (req, file, cb) => {
        const uniqueSuffix = Date.now() + '-' + Math.round(Math.random() * 1E9);
        const ext = path.extname(file.originalname);
        cb(null, 'video-' + uniqueSuffix + ext);
    }
});

const upload = multer({
    storage: storage,
    fileFilter: (req, file, cb) => {
        if (file.mimetype.startsWith('video/')) {
            cb(null, true);
        } else {
            cb(new Error('อนุญาตเฉพาะไฟล์วิดีโอเท่านั้น'), false);
        }
    }
});

// --------------------------------------------------
// 3. Middleware ตรวจสอบสิทธิ์ Admin
// --------------------------------------------------
const verifyAdmin = (req, res, next) => {
    const authHeader = req.headers['authorization'];
    const token = authHeader && authHeader.split(' ')[1];

    if (!token) return res.status(401).json({ message: 'กรุณาส่ง Token เข้ามา' });

    jwt.verify(token, process.env.JWT_SECRET || 'fallback_secret', (err, decoded) => {
        if (err) return res.status(403).json({ message: 'Token ไม่ถูกต้องหรือหมดอายุ' });
        if (decoded.role !== 'admin') {
            return res.status(403).json({ message: 'สิทธิ์ไม่ถูกต้อง (สำหรับ Admin เท่านั้น)' });
        }
        req.user = decoded;
        next();
    });
};

// --------------------------------------------------
// 4. API Endpoints
// --------------------------------------------------

// [POST] เข้าสู่ระบบ
app.post('/api/login', (req, res) => {
    const { username, password } = req.body;

    db.get(`SELECT * FROM users WHERE username = ?`, [username], (err, user) => {
        if (err) return res.status(500).json({ error: err.message });
        if (!user) return res.status(400).json({ message: 'ไม่พบบัญชีผู้ใช้นี้' });

        const isMatch = bcrypt.compareSync(password, user.password);
        if (!isMatch) return res.status(400).json({ message: 'รหัสผ่านไม่ถูกต้อง' });

        const token = jwt.sign(
            { id: user.id, username: user.username, role: user.role },
            process.env.JWT_SECRET || 'fallback_secret',
            { expiresIn: '1d' }
        );

        res.json({ message: 'เข้าสู่ระบบสำเร็จ', token, role: user.role });
    });
});

// [GET] ดึงรายการวิดีโอทั้งหมด
app.get('/api/videos', (req, res) => {
    db.all(`SELECT * FROM videos ORDER BY created_at DESC`, [], (err, rows) => {
        if (err) return res.status(500).json({ error: err.message });
        
        const videos = rows.map(video => ({
            id: video.id,
            title: video.title,
            description: video.description,
            video_url: `/uploads/${video.filename}`,
            created_at: video.created_at
        }));

        res.json(videos);
    });
});

// [POST] เพิ่มวิดีโอและบันทึกลงฐานข้อมูล (เฉพาะ Admin)
app.post('/api/videos', verifyAdmin, upload.single('video'), (req, res) => {
    if (!req.file) return res.status(400).json({ message: 'กรุณาเลือกไฟล์วิดีโอ' });

    const { title, description } = req.body;
    const filename = req.file.filename;

    const sql = `INSERT INTO videos (title, description, filename) VALUES (?, ?, ?)`;
    db.run(sql, [title || req.file.originalname, description || '', filename], function (err) {
        if (err) return res.status(500).json({ error: err.message });

        res.status(201).json({
            message: 'เพิ่มวิดีโอสำเร็จ',
            videoId: this.lastID,
            video_url: `/uploads/${filename}`
        });
    });
});

// [DELETE] ลบวิดีโอ (เฉพาะ Admin)
app.delete('/api/videos/:id', verifyAdmin, (req, res) => {
    const videoId = req.params.id;

    db.get(`SELECT filename FROM videos WHERE id = ?`, [videoId], (err, row) => {
        if (err) return res.status(500).json({ error: err.message });
        if (!row) return res.status(404).json({ message: 'ไม่พบวิดีโอนี้' });

        const filePath = path.join(uploadDir, row.filename);

        fs.unlink(filePath, (unlinkErr) => {
            db.run(`DELETE FROM videos WHERE id = ?`, [videoId], (dbErr) => {
                if (dbErr) return res.status(500).json({ error: dbErr.message });
                res.json({ message: 'ลบวิดีโอเรียบร้อยแล้ว' });
            });
        });
    });
});

// --------------------------------------------------
// 5. หน้าเว็บ UI (แสดงรายการวิดีโอ + หน้าปกอัตโนมัติ)
// --------------------------------------------------
app.get('/', (req, res) => {
    res.send(`
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบคลังวิดีโอ</title>
    <style>
        body { font-family: sans-serif; background: #121212; color: #fff; margin: 0; padding: 20px; }
        header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; padding-bottom: 10px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-top: 20px; }
        .card { background: #1e1e1e; border-radius: 8px; padding: 12px; border: 1px solid #333; }
        video { width: 100%; border-radius: 6px; background: #000; }
        button { background: #e50914; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-weight: bold; }
        button.btn-sec { background: #444; }
        .admin-box { background: #1f2937; padding: 15px; border-radius: 8px; margin-top: 15px; display: none; }
        input, textarea { width: 100%; padding: 8px; margin: 5px 0; background: #333; border: 1px solid #444; color: white; box-sizing: border-box; }
        .modal { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); justify-content:center; align-items:center; }
        .modal-content { background:#222; padding:20px; border-radius:8px; width:300px; }
    </style>
</head>
<body>

    <header>
        <h2>🎬 Video Center</h2>
        <div>
            <button id="btn-login" onclick="openLogin()">🔑 เข้าสู่ระบบ Admin</button>
            <button id="btn-logout" onclick="logout()" class="btn-sec" style="display:none;">🚪 ออกจากระบบ</button>
        </div>
    </header>

    <!-- ส่วนอัปโหลดวิดีโอ (แสดงเฉพาะ Admin) -->
    <div id="admin-panel" class="admin-box">
        <h3>➕ อัปโหลดวิดีโอใหม่</h3>
        <form id="upload-form">
            <input type="text" id="up-title" placeholder="ชื่อวิดีโอ" required>
            <textarea id="up-desc" placeholder="รายละเอียดคลิป"></textarea>
            <input type="file" id="up-file" accept="video/*" required style="color:white;">
            <br><br>
            <button type="submit">บันทึกวิดีโอ</button>
        </form>
    </div>

    <h3>วิดีโอทั้งหมด</h3>
    <div id="video-list" class="grid"></div>

    <!-- Modal ล็อกอิน -->
    <div id="login-modal" class="modal">
        <div class="modal-content">
            <h3>🔑 ล็อกอิน Admin</h3>
            <input type="text" id="user" placeholder="Username">
            <input type="password" id="pass" placeholder="Password">
            <br><br>
            <button onclick="login()">เข้าสู่ระบบ</button>
            <button onclick="closeLogin()" class="btn-sec">ยกเลิก</button>
        </div>
    </div>

    <script>
        let token = localStorage.getItem('token') || '';

        window.onload = () => {
            checkAuth();
            loadVideos();
        };

        function checkAuth() {
            document.getElementById('admin-panel').style.display = token ? 'block' : 'none';
            document.getElementById('btn-login').style.display = token ? 'none' : 'inline-block';
            document.getElementById('btn-logout').style.display = token ? 'inline-block' : 'none';
        }

        function openLogin() { document.getElementById('login-modal').style.display = 'flex'; }
        function closeLogin() { document.getElementById('login-modal').style.display = 'none'; }

        async function login() {
            const username = document.getElementById('user').value;
            const password = document.getElementById('pass').value;

            const res = await fetch('/api/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });

            const data = await res.json();
            if (res.ok) {
                token = data.token;
                localStorage.setItem('token', token);
                alert('เข้าสู่ระบบสำเร็จ');
                closeLogin();
                checkAuth();
                loadVideos();
            } else {
                alert(data.message || 'รหัสผ่านไม่ถูกต้อง');
            }
        }

        function logout() {
            localStorage.removeItem('token');
            token = '';
            checkAuth();
            loadVideos();
        }

        async function loadVideos() {
            const res = await fetch('/api/videos');
            const videos = await res.json();
            const container = document.getElementById('video-list');
            container.innerHTML = '';

            videos.forEach(v => {
                const card = document.createElement('div');
                card.className = 'card';

                let delBtn = token ? \`<button onclick="deleteVideo(\${v.id})" style="margin-top:10px; background:#b91c1c;">🗑️ ลบวิดีโอ</button>\` : '';

                // ใช้ #t=0.5 เพื่อดึงเฟรมวินาทีที่ 0.5 มาทำเป็นรูปหน้าปกอัตโนมัติ
                card.innerHTML = \`
                    <video controls preload="metadata" poster="">
                        <source src="\${v.video_url}#t=0.5" type="video/mp4">
                    </video>
                    <h4 style="margin:10px 0 5px 0;">\${v.title}</h4>
                    <p style="color:#aaa; font-size:0.9rem; margin:0;">\${v.description || ''}</p>
                    \${delBtn}
                \`;
                container.appendChild(card);
            });
        }

        // อัปโหลดและบันทึก
        document.getElementById('upload-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData();
            formData.append('title', document.getElementById('up-title').value);
            formData.append('description', document.getElementById('up-desc').value);
            formData.append('video', document.getElementById('up-file').files[0]);

            const res = await fetch('/api/videos', {
                method: 'POST',
                headers: { 'Authorization': 'Bearer ' + token },
                body: formData
            });

            if (res.ok) {
                alert('อัปโหลดวิดีโอสำเร็จ!');
                document.getElementById('upload-form').reset();
                loadVideos();
            } else {
                alert('อัปโหลดไม่สำเร็จ');
            }
        });

        async function deleteVideo(id) {
            if (!confirm('ต้องการลบวิดีโอนี้หรือไม่?')) return;
            const res = await fetch('/api/videos/' + id, {
                method: 'DELETE',
                headers: { 'Authorization': 'Bearer ' + token }
            });
            if (res.ok) {
                alert('ลบเรียบร้อย');
                loadVideos();
            }
        }
    </script>
</body>
</html>
    `);
});

// --------------------------------------------------
// Start Server
// --------------------------------------------------
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
    console.log(`Server running at http://localhost:${PORT}`);
});
