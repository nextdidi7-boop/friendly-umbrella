local function setupCharacter(character)
    local newHumanoid = character:WaitForChild("Humanoid")
    local newRoot = character:WaitForChild("HumanoidRootPart")

    if speedConnection then
        speedConnection:Disconnect()
        speedConnection = nil
    end

    humanoid = newHumanoid
    root = newRoot

    originalJumpPower = humanoid.JumpPower
    originalJumpHeight = humanoid.JumpHeight

    humanoid.UseJumpPower = true

    humanoid.JumpPower = jumpEnabled
        and jumpValue
        or originalJumpPower

    -- CFrame Speed logic based on the supplied original function
    speedConnection = RunService.RenderStepped:Connect(function()
        if not (_G.Settings.CustomWalkSpeed or speedEnabled) then
            return
        end

        if not humanoid or not root then
            return
        end

        if not humanoid.Parent or not root.Parent then
            return
        end

        if humanoid.MoveDirection.Magnitude > 0 then
            root.CFrame = root.CFrame
                + humanoid.MoveDirection.Unit
                * (_G.Settings.SpeedMultiplier * 0.05)
        end
    end)
end

