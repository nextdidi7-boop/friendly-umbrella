        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- ยิง 2 นัดซ้อนเมื่อคลิกยิงเอง
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if _G.Settings.BurstTwoEnabled and getEquippedTool() then
            fireBurstTwo()
        end
    end
end)

local function setupCharacterEvents(char)
    if not char then return end
    if _G.BoobSettings.Enabled then _G.BuildSoftBoob(char) end

    local hum = char:WaitForChild("Humanoid", 3)
    if hum then
        hum.HealthChanged:Connect(function()
            if _G.Settings.AutoReturnFire and getEquippedTool() then
                local target = GetClosestTarget()
                if target and (tick() - _G.LastShootTime > _G.Settings.FireRateVal) then
                    _G.LastShootTime = tick()
                    if _G.Settings.BurstTwoEnabled then
                        fireBurstTwo()
                    else
                        fireGun()
                    end
                end
            end
        end)
    end
end

if LocalPlayer.Character then setupCharacterEvents(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupCharacterEvents)

Players.PlayerAdded:Connect(function(Player)
    Player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if Player.Character then CreatePlayerESP(Player) end
    end)
end)

Players.PlayerRemoving:Connect(function(Player)
    RemovePlayerESP(Player)
end)

_G.joinLowPlayerServer = function()
    local api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(api)) end)
    if success and result and result.data then
        for _, server in ipairs(result.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                break
            end
        end
    end
end
