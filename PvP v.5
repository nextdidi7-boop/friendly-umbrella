local function RemovePlayerESP(Player)
    local Folder = PlayerESPFolder:FindFirstChild(tostring(Player.UserId))
    if Folder then Folder:Destroy() end
    if HIGHLIGHT_CACHE[Player] then
        pcall(function() HIGHLIGHT_CACHE[Player]:Destroy() end)
        HIGHLIGHT_CACHE[Player] = nil
    end
end

local function CreatePlayerESP(Player)
    if Player == LocalPlayer then return end
    local Character = Player.Character
    if not Character or not isAlive(Character) then return end
    local Head = Character:FindFirstChild("Head")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Head or not Humanoid then return end

    RemovePlayerESP(Player)

    local Folder = Instance.new("Folder", PlayerESPFolder)
    Folder.Name = tostring(Player.UserId)

    if _G.Settings.HighlightESP or _G.Settings.RainbowESP then
        local Highlight = Instance.new("Highlight")
        Highlight.Name = "PlayerHighlight"
        Highlight.Adornee = Character
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        Highlight.FillTransparency = 0.75
        Highlight.OutlineTransparency = 0
        Highlight.FillColor = Color3.fromRGB(255, 0, 0)
        Highlight.OutlineColor = _G.Settings.RainbowESP and GetRainbow(0.25) or Color3.fromRGB(255, 255, 255)
        Highlight.Parent = Folder
        HIGHLIGHT_CACHE[Player] = Highlight
    end

    if _G.Settings.NameESP or _G.Settings.HealthESP or _G.Settings.ToolESP then
        local Billboard = Instance.new("BillboardGui", Folder)
        Billboard.Name = "PlayerInfo"
        Billboard.Adornee = Head
        Billboard.AlwaysOnTop = true
        Billboard.Size = UDim2.fromOffset(220, 90)
        Billboard.StudsOffset = Vector3.new(0, 3, 0)

        local Container = Instance.new("Frame", Billboard)
        Container.BackgroundTransparency = 1
        Container.Size = UDim2.fromScale(1, 1)

        local Layout = Instance.new("UIListLayout", Container)
        Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        Layout.VerticalAlignment = Enum.VerticalAlignment.Center
        Layout.Padding = UDim.new(0, 2)

        if _G.Settings.NameESP then
            local NameLabel = Instance.new("TextLabel", Container)
            NameLabel.BackgroundTransparency = 1
            NameLabel.Size = UDim2.fromOffset(210, 22)
            NameLabel.Text = Player.DisplayName .. " (@" .. Player.Name .. ")"
            NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            NameLabel.TextStrokeTransparency = 0
            NameLabel.TextScaled = true
            NameLabel.Font = Enum.Font.GothamBold
        end

        if _G.Settings.HealthESP then
            local HealthBack = Instance.new("Frame", Container)
            HealthBack.Size = UDim2.fromOffset(140, 10)
            HealthBack.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            HealthBack.BorderSizePixel = 0
            Instance.new("UICorner", HealthBack).CornerRadius = UDim.new(1, 0)

            local HealthBar = Instance.new("Frame", HealthBack)
            HealthBar.Size = UDim2.fromScale(math.clamp(Humanoid.Health / math.max(Humanoid.MaxHealth, 1), 0, 1), 1)
            HealthBar.BackgroundColor3 = Color3.fromRGB(50, 255, 100)
            HealthBar.BorderSizePixel = 0
            Instance.new("UICorner", HealthBar).CornerRadius = UDim.new(1, 0)

            local HPText = Instance.new("TextLabel", Container)
            HPText.BackgroundTransparency = 1
            HPText.Size = UDim2.fromOffset(210, 18)
            HPText.Text = math.floor(Humanoid.Health) .. " / " .. math.floor(Humanoid.MaxHealth) .. " HP"
            HPText.TextColor3 = Color3.fromRGB(255, 255, 255)
            HPText.TextStrokeTransparency = 0
            HPText.TextScaled = true
            HPText.Font = Enum.Font.Gotham

            Humanoid.HealthChanged:Connect(function(Health)
                if not HealthBar.Parent then return end
                local MaxHealth = math.max(Humanoid.MaxHealth, 1)
                HealthBar.Size = UDim2.fromScale(math.clamp(Health / MaxHealth, 0, 1), 1)
                HPText.Text = math.floor(Health) .. " / " .. math.floor(MaxHealth) .. " HP"
            end)
        end

        if _G.Settings.ToolESP then
            local ToolLabel = Instance.new("TextLabel", Container)
            ToolLabel.BackgroundTransparency = 1
            ToolLabel.Size = UDim2.fromOffset(210, 20)
            ToolLabel.TextColor3 = Color3.fromRGB(255, 220, 80)
            ToolLabel.TextStrokeTransparency = 0
            ToolLabel.TextScaled = true
            ToolLabel.Font = Enum.Font.GothamBold

            local function UpdateTool()
                local t = Character:FindFirstChildOfClass("Tool")
                ToolLabel.Text = "ถือ: " .. (t and t.Name or "-")
            end
            UpdateTool()
            Character.ChildAdded:Connect(function(o) if o:IsA("Tool") then task.wait(); UpdateTool() end end)
            Character.ChildRemoved:Connect(function(o) if o:IsA("Tool") then task.wait(); UpdateTool() end end)
        end
    end
end

_G.RefreshPlayerESP = function()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            if Player.Character then CreatePlayerESP(Player) end
            Player.CharacterAdded:Connect(function()
                task.wait(0.5)
                if Player.Character then CreatePlayerESP(Player) end
            end)
        end
    end
end

_G.ScanWorld = function()
    if not _G.Settings.WorldESP then return end
    for _, Object in ipairs(Workspace:GetDescendants()) do
        if (Object:IsA("Tool") or Object:IsA("Model")) and not Object:IsDescendantOf(PlayerESPFolder) and not WorldCache[Object] then
            local Part = Object:IsA("BasePart") and Object or (Object:IsA("Model") and (Object.PrimaryPart or Object:FindFirstChildWhichIsA("BasePart", true)))
            if Part then
                local Billboard = Instance.new("BillboardGui", WorldESPFolder)
                Billboard.Adornee = Part
                Billboard.AlwaysOnTop = true
                Billboard.Size = UDim2.fromOffset(180, 30)

                local Label = Instance.new("TextLabel", Billboard)
                Label.BackgroundTransparency = 1
                Label.Size = UDim2.fromScale(1, 1)
                Label.Text = "📦 " .. tostring(Object.Name)
                Label.TextColor3 = Color3.fromRGB(255, 255, 255)
                Label.TextStrokeTransparency = 0
                Label.TextScaled = true
                Label.Font = Enum.Font.GothamBold

                WorldCache[Object] = Billboard
                Object.AncestryChanged:Connect(function(_, Parent)
                    if not Parent and WorldCache[Object] then
                        WorldCache[Object]:Destroy()
                        WorldCache[Object] = nil
                    end
                end)
            end
        end
    end
end

_G.ClearWorldESP = function()
    for k, v in pairs(WorldCache) do if v then v:Destroy() end end
    WorldCache = {}
end

task.spawn(function()
    while task.wait(0.1) do
        if not _G.Settings.NPC_ESP then
            for model, textObj in pairs(NPC_CACHE) do pcall(function() textObj:Remove() end) end
            NPC_CACHE = {}
        else
            local activeNPCs = {}
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")

                    if hum and hum.Health > 0 and hrp then
                        activeNPCs[obj] = true
                        if not NPC_CACHE[obj] then
                            local t = Drawing.new("Text")
                            t.Center = true
                            t.Outline = true
                            t.Font = 2
                            t.Size = 13
                            t.Color = Color3.fromRGB(0, 255, 150)
                            NPC_CACHE[obj] = t
                        end

                        local pos, on = Camera:WorldToViewportPoint(hrp.Position)
                        if on then
                            NPC_CACHE[obj].Text = "[NPC] " .. obj.Name
                            NPC_CACHE[obj].Position = Vector2.new(pos.X, pos.Y - 20)
                            NPC_CACHE[obj].Visible = true
                        else
                            NPC_CACHE[obj].Visible = false
                        end
                    end
                end
            end
            for model, textObj in pairs(NPC_CACHE) do
                if not activeNPCs[model] then
                    pcall(function() textObj:Remove() end)
                    NPC_CACHE[model] = nil
                end
            end
        end
    end
end)

local function UpdateHitbox()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and isAlive(p.Character) and not isTeammate(p) then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local head = p.Character:FindFirstChild("Head")

            if hrp then
                if not OriginalSizes[hrp] then
                    OriginalSizes[hrp] = {Size = hrp.Size, Transparency = hrp.Transparency, CanCollide = hrp.CanCollide}
                end
                if _G.Settings.HitboxEnabled then
                    hrp.Size = Vector3.new(_G.Settings.HitboxSize, _G.Settings.HitboxSize, _G.Settings.HitboxSize)
                    hrp.Transparency = 0.7
                    hrp.Color = Color3.fromRGB(255, 170, 0)
                    hrp.Material = Enum.Material.SmoothPlastic
                    hrp.CanCollide = false
                else
                    hrp.Size = OriginalSizes[hrp].Size
                    hrp.Transparency = OriginalSizes[hrp].Transparency
                    hrp.CanCollide = OriginalSizes[hrp].CanCollide
                end
            end

            if head then
                if not OriginalSizes[head] then
                    OriginalSizes[head] = {Size = head.Size, Transparency = head.Transparency, CanCollide = head.CanCollide}
                end
                if _G.Settings.BigHeadEnabled then
                    head.Size = Vector3.new(_G.Settings.BigHeadSize, _G.Settings.BigHeadSize, _G.Settings.BigHeadSize)
                    head.Transparency = 0.5
                    head.CanCollide = false
                else
                    head.Size = OriginalSizes[head].Size
                    head.Transparency = OriginalSizes[head].Transparency
                    head.CanCollide = OriginalSizes[head].CanCollide
                end
            end
        end
    end
end

RunService.Stepped:Connect(function()
    if _G.Settings.GodModeEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = hum.MaxHealth end
    end

    if _G.Settings.WalkSpeedEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = _G.Settings.WalkSpeedVal end
    end

    if _G.Settings.AutoReloadEnabled then
        local tool = getEquippedTool()
        if tool then
            for _, v in ipairs(tool:GetDescendants()) do
                if (v:IsA("IntValue") or v:IsA("NumberValue")) then
                    local name = v.Name:lower()
                    if (name:find("ammo") or name:find("clip") or name:find("bullet")) and v.Value <= 0 then
                        fastReload()
                        break
                    end
                end
            end
        end
    end

    if _G.Settings.HitboxEnabled or _G.Settings.BigHeadEnabled then
        UpdateHitbox()
    end
end)

-- ลูปอัปเดตตำแหน่งเส้นชี้เป้าและการยิง
RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = _G.Settings.FOVEnabled
    local Size = math.clamp(_G.Settings.FOVSize, 1, 300)
    FOVCircle.Size = UDim2.fromOffset(Size * 2, Size * 2)
    FOVStroke.Color = _G.Settings.RainbowFOV and GetRainbow(1) or Color3.fromRGB(255, 255, 255)

    AimLine.Visible = false
    local Target = GetClosestTarget()

    if Target then
        if _G.Settings.AimbotEnabled then
            local CurrentCF = Camera.CFrame
            local TargetCF = CFrame.lookAt(CurrentCF.Position, Target.Position)
            Camera.CFrame = CurrentCF:Lerp(TargetCF, _G.Settings.Smoothness)
        end

        if _G.Settings.CameraLock then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Target.Position)
        end

        -- วาดเส้นสีแดงชี้ตรงเข้าหัวเป้าหมาย
        if _G.Settings.SilentAim then
            local p, onScreen = Camera:WorldToViewportPoint(Target.Position)
            if onScreen then
                AimLine.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                AimLine.To = Vector2.new(p.X, p.Y)
                AimLine.Color = Color3.fromRGB(255, 0, 0)
                AimLine.Visible = true
            end
        end

        if _G.Settings.AutoShootEnabled and getEquippedTool() then
            if tick() - _G.LastShootTime > _G.Settings.FireRateVal then
                _G.LastShootTime = tick()
                if _G.Settings.BurstTwoEnabled then
                    fireBurstTwo()
                else
                    fireGun()
                end
            end
        end
    end

    if _G.Settings.RainbowESP then
        for _, h in pairs(HIGHLIGHT_CACHE) do
            if h then h.OutlineColor = GetRainbow(0.25) end
        end
    end

    if _G.Settings.FullbrightEnabled then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
    end
end)

