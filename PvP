--// HELPERS
local function makeButton(text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.Parent = Scroll

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    btn.MouseButton1Click:Connect(function()
        callback(btn)
    end)
    return btn
end

local function makeToggle(text, key, callback)
    local btn = makeButton(text .. ": OFF", function(b)
        Config[key] = not Config[key]
        b.Text = text .. ": " .. (Config[key] and "ON" or "OFF")
        b.BackgroundColor3 = Config[key] and Color3.fromRGB(60, 120, 60) or Color3.fromRGB(45, 45, 55)
        if callback then callback(Config[key]) end
    end)
    return btn
end
--[[
    PvP Script v.3 — PART 2/4
    Core Features: Invisible, Head In Ground,
    Rapid Fire, Fast Reload, Item Vacuum
--]]

--// FEATURE: INVISIBLE
local function setInvisible(state)
    for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = state and 1 or 0
            part.Transparency = state and 1 or part.Transparency
        end
    end
    if state then
        LocalPlayer.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = 1
                end
            end
        end)
    end
end

--// FEATURE: HEAD IN GROUND
local function headInGround(state)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if state then
        if hrp then hrp.CFrame = hrp.CFrame * CFrame.new(0, -3, 0) end
        if head then head.CFrame = head.CFrame * CFrame.new(0, -3, 0) end
    else
        if hrp then hrp.CFrame = hrp.CFrame * CFrame.new(0, 3, 0) end
    end
end

--// FEATURE: RAPID FIRE
local rapidFireConn
local function rapidFire(state)
    if rapidFireConn then rapidFireConn:Disconnect() rapidFireConn = nil end
    if state then
        rapidFireConn = RunService.RenderStepped:Connect(function()
            local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
            if tool and Mouse.Button1Down then
                tool:Activate()
            end
        end)
    end
end

--// FEATURE: FAST RELOAD
local fastReloadConn
local function fastReload(state)
    if fastReloadConn then fastReloadConn:Disconnect() fastReloadConn = nil end
    if state then
        fastReloadConn = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                for _, v in ipairs(tool:GetDescendants()) do
                    if v:IsA("NumberValue") and (v.Name:lower():find("reload") or v.Name:lower():find("cooldown")) then
                        v.Value = 0
                    end
                end
            end
        end)
    end
end

--// FEATURE: ITEM VACUUM
local vacuumConn
local function itemVacuum(state)
    if vacuumConn then vacuumConn:Disconnect() vacuumConn = nil end
    if state then
        vacuumConn = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                    local dist = (v.Position - hrp.Position).Magnitude
                    if dist < 50 and dist > 2 then
                        pcall(function()
                            v.CFrame = hrp.CFrame
                        end)
                    end
                end
            end
        end)
    end
end
--[[
    PvP Script v.3 — PART 3/4
    Movement + Combat: Speed, Jump, NoClip,
    Aim Assist, ESP
--]]

--// FEATURE: SPEED
local function applySpeed(state)
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Humanoid") then
        char.Humanoid.WalkSpeed = state and Config.SpeedValue or 16
    end
end

--// FEATURE: JUMP
local function applyJump(state)
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Humanoid") then
        char.Humanoid.JumpPower = state and Config.JumpValue or 50
        char.Humanoid.UseJumpPower = true
    end
end

--// FEATURE: NOCLIP
local noclipConn
local function noclip(state)
    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
    if state then
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, v in ipairs(char:GetDescendants()) do
                    if v:IsA("BasePart") and v.CanCollide then
                        v.CanCollide = false
                    end
                end
            end
        end)
    end
end

--// FEATURE: AIM ASSIST
local aimConn
local function aimAssist(state)
    if aimConn then aimConn:Disconnect() aimConn = nil end
    if state then
        aimConn = RunService.RenderStepped:Connect(function()
            local closest, closestDist = nil, math.huge
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local head = plr.Character:FindFirstChild("Head")
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if head and hrp then
                        local dist = (head.Position - hrp.Position).Magnitude
                        if dist < closestDist and dist < 300 then
                            closest, closestDist = head, dist
                        end
                    end
                end
            end
            if closest and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, closest.Position)
            end
        end)
    end
end

--// FEATURE: ESP
local espFolder = Instance.new("Folder", ScreenGui)
espFolder.Name = "ESP"
local espConn
local function esp(state)
    if espConn then espConn:Disconnect() espConn = nil end
    for _, v in ipairs(espFolder:GetChildren()) do v:Destroy() end
    if state then
        espConn = RunService.RenderStepped:Connect(function()
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local head = plr.Character:FindFirstChild("Head")
                    if head then
                        local existing = espFolder:FindFirstChild(plr.Name)
                        if not existing then
                            local billboard = Instance.new("BillboardGui")
                            billboard.Name = plr.Name
                            billboard.Size = UDim2.new(0, 100, 0, 30)
                            billboard.AlwaysOnTop = true
                            billboard.Parent = espFolder

                            local label = Instance.new("TextLabel")
                            label.Size = UDim2.new(1, 0, 1, 0)
                            label.BackgroundTransparency = 1
                            label.Text = plr.Name
                            label.TextColor3 = Color3.fromRGB(255, 60, 60)
                            label.TextStrokeTransparency = 0
                            label.Font = Enum.Font.GothamBold
                            label.TextSize = 12
                            label.Parent = billboard

                            billboard.Adornee = head
                        end
                    end
                end
            end
            for _, v in ipairs(espFolder:GetChildren()) do
                local plr = Players:FindFirstChild(v.Name)
                if not plr or not plr.Character or not plr.Character:FindFirstChild("Head") then
                    v:Destroy()
                end
            end
        end)
    end
end
