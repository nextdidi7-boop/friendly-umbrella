local function fireGun()
    if IsReloading then return end
    local tool = getEquippedTool()
    if tool then
        tool:Activate()
        task.wait(math.clamp(FireRateVal, 0.05, 1))
        tool:Deactivate()
    end
end

local function fastReload()
    if IsReloading then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local tool = getEquippedTool()
    if hum and tool then
        IsReloading = true
        task.wait(ReloadSpeedVal)
        hum:UnequipTools()
        task.wait(0.05)
        hum:EquipTool(tool)
        IsReloading = false
    end
end

local function handleAutoReload()
    if not AutoReloadEnabled or IsReloading then return end
    local tool = getEquippedTool()
    if tool then
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("IntValue") or v:IsA("NumberValue") then
                local name = v.Name:lower()
                if (name:find("ammo") or name:find("clip") or name:find("bullet")) and v.Value <= 0 then
                    fastReload()
                    break
                end
            end
        end
    end
end

local function handleInfiniteAmmo()
    if not InfiniteAmmoEnabled then return end
    local tool = getEquippedTool()
    if tool then
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("IntValue") or v:IsA("NumberValue") then
                local name = v.Name:lower()
                if name:find("ammo") or name:find("clip") or name:find("bullet") or name:find("mag") then
                    if v.Value < 30 then v.Value = 999 end
                end
            end
        end
    end
end

local function handleNoRecoil()
    if not NoRecoilEnabled then return end
    local tool = getEquippedTool()
    if tool then
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local name = v.Name:lower()
                if name:find("recoil") or name:find("spread") or name:find("kick") then
                    v.Value = 0
                end
            end
        end
    end
end

local function handleWallBang()
    if not WallBangEnabled then return end
    -- ทำให้กระสุนทะลุกำแพง (generic approach)
    local tool = getEquippedTool()
    if tool then
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("BoolValue") then
                local name = v.Name:lower()
                if name:find("wall") or name:find("penetrat") or name:find("pierce") then
                    if v:IsA("BoolValue") then v.Value = true
                    else v.Value = 999 end
                end
            end
        end
    end
end

