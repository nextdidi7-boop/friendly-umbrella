--// RESET BUTTON
makeButton("RESET ALL", function()
    for k, v in pairs(Config) do
        if type(v) == "boolean" then Config[k] = false end
    end
    if rapidFireConn then rapidFireConn:Disconnect() end
    if fastReloadConn then fastReloadConn:Disconnect() end
    if vacuumConn then vacuumConn:Disconnect() end
    if noclipConn then noclipConn:Disconnect() end
    if aimConn then aimConn:Disconnect() end
    if espConn then espConn:Disconnect() end
    setInvisible(false)
    applySpeed(false)
    applyJump(false)
    esp(false)
    for _, v in ipairs(Scroll:GetChildren()) do
        if v:IsA("TextButton") then
            if v.Text:find(":") then
                v.Text = v.Text:gsub(": ON", ": OFF")
                v.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            end
        end
    end
end)

--// RESPAWN HANDLER
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1)
    if Config.SpeedHack then applySpeed(true) end
    if Config.JumpHack then applyJump(true) end
    if Config.Invisible then setInvisible(true) end
end)

