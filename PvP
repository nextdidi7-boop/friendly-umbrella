-- MAIN LOOP
-- ==================================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

if LocalPlayer.Character then
    OnCharacterAdded(LocalPlayer.Character)
    HookCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    OnCharacterAdded(char)
    HookCharacter(char)
end)

LocalPlayer.CharacterRemoving:Connect(OnCharacterRemoving)

-- Settings watcher: rebuild on toggle
BoobSettings.Changed:Connect(function(key)
    if key == "Enabled" or key == "Size" or key == "Jiggle" or key == "PhysicsBounce" then
        if BoobSettings.Enabled and LocalPlayer.Character then
            DestroyBoobs()
            BuildSoftBoob(LocalPlayer.Character)
        elseif not BoobSettings.Enabled then
            DestroyBoobs()
        end
    end
end)

