        if v and v.Parent then pcall(function() v:Destroy() end) end
    end
    CreatedBoobParts = {}
    LeftMeshWeld, RightMeshWeld = nil, nil
end

local function BuildSoftBoob(char)
    DestroyBoobs()
    if not char or not char.Parent then return end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local head = char:FindFirstChild("Head")
    if not torso then return end
    local skinCol = head and head.Color or torso.Color
    local pink1 = Color3.fromRGB(255, 130, 155)
    local pink2 = Color3.fromRGB(255, 80, 120)
    local s = BoobSettings.Size
    local function createSphere(cf, size, col, parentWeld)
        local p = Instance.new("Part")
        p.Shape = Enum.PartType.Ball
        p.Size = size
        p.Color = col
        p.Material = Enum.Material.SmoothPlastic
        p.CanCollide = false
        p.Massless = true
        p.Parent = char
        local w = Instance.new
-- ==================================================
-- [PART 6/6] BOOB SYSTEM (CONT.) — CHARACTER EVENTS & MAIN LOOP
-- ==================================================

        local w = Instance.new("Weld")
        w.Part0 = torso
        w.Part1 = p
        w.C0 = torso.CFrame:Inverse() * cf
        w.Parent = p

        if parentWeld then parentWeld(p, w) end

        table.insert(CreatedBoobParts, p)
        return p, w
    end

    local baseOffset = Vector3.new(0, 0.35, -0.55)
    local spread = Vector3.new(0.42, 0, 0)

    local leftPos  = torso.CFrame * CFrame.new(baseOffset - spread)
    local rightPos = torso.CFrame * CFrame.new(baseOffset + spread)

    local lPart, lWeld = createSphere(leftPos, Vector3.new(s, s, s), skinCol, function(part, weld)
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.Sphere
        mesh.Scale = Vector3.new(1, 0.85, 1)
        mesh.Parent = part
        LeftMeshWeld = weld
    end)

    local rPart, rWeld = createSphere(rightPos, Vector3.new(s, s, s), skinCol, function(part, weld)
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.Sphere
        mesh.Scale = Vector3.new(1, 0.85, 1)
        mesh.Parent = part
        RightMeshWeld = weld
    end)

    -- Nipple caps
    local function makeNipple(parentPart, offsetCF)
        local n = Instance.new("Part")
        n.Shape = Enum.PartType.Ball
        n.Size = Vector3.new(s * 0.32, s * 0.32, s * 0.32)
        n.Color = pink1
        n.Material = Enum.Material.SmoothPlastic
        n.CanCollide = false
        n.Massless = true
        n.Parent = char

        local nw = Instance.new("Weld")
        nw.Part0 = parentPart
        nw.Part1 = n
        nw.C0 = offsetCF
        nw.Parent = n

        table.insert(CreatedBoobParts, n)
        return n
    end

    makeNipple(lPart, CFrame.new(0, -s * 0.38, -s * 0.42) * CFrame.Angles(math.rad(-90), 0, 0))
    makeNipple(rPart, CFrame.new(0, -s * 0.38, -s * 0.42) * CFrame.Angles(math.rad(-90), 0, 0))

    -- Jiggle: bind to HumanoidRootPart velocity
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum then
        local running = false
        local conn
        conn = RunService.Heartbeat:Connect(function(dt)
            if not (lWeld and lWeld.Parent and rWeld and rWeld.Parent) then
                conn:Disconnect()
                return
            end
            local vel = hrp.AssemblyLinearVelocity
            local speed = vel.Magnitude
            local bounce = math.clamp(speed / 60, 0, 1) * BoobSettings.Jiggle
            local t = tick() * 12

            local lOffset = CFrame.new(0, math.sin(t) * bounce * 0.04, -bounce * 0.05)
            local rOffset = CFrame.new(0, math.sin(t + math.pi) * bounce * 0.04, -bounce * 0.05)

            lWeld.C0 = CFrame.new(baseOffset - spread) * lOffset
            rWeld.C0 = CFrame.new(baseOffset + spread) * rOffset

            if BoobSettings.PhysicsBounce and hum.MoveDirection.Magnitude > 0.1 then
                local tilt = math.rad(math.sin(t * 0.5) * 4 * bounce)
                lWeld.C0 = lWeld.C0 * CFrame.Angles(tilt, 0, 0)
                rWeld.C0 = rWeld.C0 * CFrame.Angles(tilt, 0, 0)
            end
        end)
    end
end

-- ==================================================
-- CHARACTER EVENTS
-- ==================================================

local function OnCharacterAdded(char)
    task.wait(0.5)
    if not char or not char.Parent then return end
    if BoobSettings.Enabled then
        BuildSoftBoob(char)
    end
end

local function OnCharacterRemoving()
    DestroyBoobs()
end

local function HookCharacter(char)
    if not char then return end
    char.ChildAdded:Connect(function(c)
        if c:IsA("Accessory") or c.Name == "Shirt" or c.Name == "Pants" then
            task.wait(0.1)
            if BoobSettings.Enabled then
                DestroyBoobs()
                BuildSoftBoob(char)
            end
        end
    end)
end

