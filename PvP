    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1)
    if BoobSettings.Enabled then BuildSoftBoob(char) end
end)

local function UpdateHitbox()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            if char and isAlive(char) and not isTeammate(p) then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not OriginalSizes[hrp] then
                        OriginalSizes[hrp] = {Size = hrp.Size, Transparency = hrp.Transparency, CanCollide = hrp.CanCollide}
                    end
                    if HitboxEnabled then
                        hrp.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                        hrp.Transparency = 0.7
                        hrp.Color = Color3.fromRGB(255, 170, 0)
                        hrp.Material = Enum.Material.SmoothPlastic
                        hrp.CanCollide = false
                    else
                        if OriginalSizes[hrp] then
                            hrp.Size = OriginalSizes[hrp].Size
                            hrp.Transparency = OriginalSizes[hrp].Transparency
                            hrp.CanCollide = OriginalSizes[hrp].CanCollide
                        end
                    end
                end
            end
        end
    end
end

-- NPC ESP Loop
task.spawn(function()
    while task.wait(0.5) do
        if not ESP_NPC_ENABLED then
            for model, textObj in pairs(NPC_CACHE) do pcall(function() textObj:Remove() end) end
            NPC_CACHE = {}
        else
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                    local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                    if hrp then
                        if not NPC_CACHE[obj] then
                            local t = Drawing.new("Text")
                            t.Center = true
                            t.Outline = true
                            t.Font = 2
                            t.Size = 13
                            t.Color = Color3.fromRGB(0, 255, 150)
                            NPC_CACHE[obj] = t
                        end

                        local pos, on = Camera:WorldToViewportPoint(hrp.Position)
                        if on then
                            NPC_CACHE[obj].Text = "[NPC] " .. obj.Name
                            NPC_CACHE[obj].Position = Vector2.new(pos.X, pos.Y - 20)
                            NPC_CACHE[obj].Visible = true
                        else
                            NPC_CACHE[obj].Visible = false
                        end
                    end
                end
            end
        end
    end
end)

local function joinLowPlayerServer()
    local api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, result = pcall(function() return HttpService:JSONDecode(game:HttpGet(api)) end)
    if success and result and result.data then
        for _, server in ipairs(result.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                break
            end
        end
    end
end

-- RenderStepped
RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    FOVCircle.Position = center
    FOVCircle.Radius = FOV
    FOVCircle.Visible = SilentAim or CAMERA_LOCK

    AimLine.Visible = false
    CurrentTarget = nil

    if SilentAim or CAMERA_LOCK then CurrentTarget = getTarget() end
    if CAMERA_LOCK and CurrentTarget then cameraLookAt(CurrentTarget) end

    if SilentAim and not CAMERA_LOCK and CurrentTarget then
        local p = Camera:WorldToViewportPoint(CurrentTarget.Position)
        AimLine.From = center
        AimLine.To = Vector2.new(p.X,p.Y)
        AimLine.Visible = true
    end

    ESP_SYSTEM()
    RAINBOW_ESP_SYSTEM()

    for char,_ in pairs(ESP_CACHE) do if not isCharValid(char) then clearESP(char) end end
    for char,_ in pairs(HIGHLIGHT_CACHE) do if not isCharValid(char) then clearHighlight(char) end end

    if WalkSpeedEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = WalkSpeedVal end
    end

    if FullbrightEnabled then
        Lighting.Brightness = BrightnessVal
        Lighting.ClockTime = 12
    end
end)

