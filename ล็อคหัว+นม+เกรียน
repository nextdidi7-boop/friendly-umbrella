--------------------------------------------------
-- ระบบสปริงฟิสิกส์ (Spring Engine ละมุน 3 มิติ)
--------------------------------------------------
local Spring = {
    Position = Vector3.new(0, 0, 0),
    Velocity = Vector3.new(0, 0, 0),
    Target = Vector3.new(0, 0, 0)
}

function Spring:Update(dt, stiffness, damping)
    local force = (self.Target - self.Position) * stiffness
    self.Velocity = (self.Velocity + force * dt) * (1 - math.clamp(damping, 0, 1))
    self.Position = self.Position + self.Velocity * dt
    return self.Position
end

--------------------------------------------------
-- ระบบสร้างโมเดลหน้าอกละมุนทรงหยดน้ำ (Realistic Tear-Drop Boobs)
--------------------------------------------------
local CreatedBoobs = {}
local LeftWeld, RightWeld = nil, nil
local BaseLeftC0 = CFrame.new(-0.42, 0.2, -0.6)
local BaseRightC0 = CFrame.new(0.42, 0.2, -0.6)
local LastHRPPosition = nil
local LastCameraRotation = Camera.CFrame.LookVector

local function removeBoobs()
    for _, item in ipairs(CreatedBoobs) do
        if item and item.Parent then item:Destroy() end
    end
    CreatedBoobs = {}
    LeftWeld, RightWeld = nil, nil
end

local function createSoftPart(character, cframeOffset, size, color, parentWeldTo, shape)
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if not torso then return nil end

    local part = Instance.new("Part")
    part.Shape = shape or Enum.PartType.Ball
    part.Size = size
    part.Color = color
    part.Material = Enum.Material.SmoothPlastic
    part.CanCollide = false
    part.Massless = true
    part.Parent = character

    local weld = Instance.new("Weld")
    weld.Part0 = parentWeldTo or torso
    weld.Part1 = part
    weld.C0 = cframeOffset
    weld.Parent = part

    table.insert(CreatedBoobs, part)
    return part, weld
end

local function applyBoobs()
    removeBoobs()
    local char = LocalPlayer.Character
    if not isCharValid(char) then return end

    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local head = char:FindFirstChild("Head")
    if not torso then return end

    local skinColor = head and head.Color or torso.Color
    local pinkAreolaColor = Color3.fromRGB(255, 145, 165)
    local pinkNippleColor = Color3.fromRGB(255, 110, 140)
    local sz = Settings.BoobSize

    -- สร้างฐานเต้านมทรงหยดน้ำ (ซ้อนก้อนไล่ระดับให้ดูละมุน ไม่สั้นแข็งเป็นก้อนกลม)
    local leftBase, lW = createSoftPart(char, BaseLeftC0, Vector3.new(1.1 * sz, 1.25 * sz, 1.2 * sz), skinColor)
    local rightBase, rW = createSoftPart(char, BaseRightC0, Vector3.new(1.1 * sz, 1.25 * sz, 1.2 * sz), skinColor)
    LeftWeld = lW
    RightWeld = rW

    -- เสริมความนุ่มมนด้านล่าง
    createSoftPart(char, CFrame.new(0, -0.15 * sz, 0.05 * sz), Vector3.new(1.0 * sz, 1.0 * sz, 1.1 * sz), skinColor, leftBase)
    createSoftPart(char, CFrame.new(0, -0.15 * sz, 0.05 * sz), Vector3.new(1.0 * sz, 1.0 * sz, 1.1 * sz), skinColor, rightBase)

    -- ปานนมละมุน
    createSoftPart(char, CFrame.new(0, 0.02, -0.58 * sz), Vector3.new(0.42 * sz, 0.42 * sz, 0.1 * sz), pinkAreolaColor, leftBase)
    createSoftPart(char, CFrame.new(0, 0.02, -0.58 * sz), Vector3.new(0.42 * sz, 0.42 * sz, 0.1 * sz), pinkAreolaColor, rightBase)

    -- ปลายหัวนม
    createSoftPart(char, CFrame.new(0, 0.02, -0.62 * sz), Vector3.new(0.18 * sz, 0.18 * sz, 0.12 * sz), pinkNippleColor, leftBase)
    createSoftPart(char, CFrame.new(0, 0.02, -0.62 * sz), Vector3.new(0.18 * sz, 0.18 * sz, 0.12 * sz), pinkNippleColor, rightBase)
end

-- คำนวณความเด้งละมุนตาม Frame
RunService.RenderStepped:Connect(function(dt)
    if Settings.BoobFeature and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and LeftWeld and RightWeld then
            local currentPos = hrp.Position
            local currentCamLook = Camera.CFrame.LookVector

            if LastHRPPosition then
                -- แรงจากการเคลื่อนที่ตัวละคร
                local velocity = (currentPos - LastHRPPosition) / dt
                local localVel = hrp.CFrame:VectorToObjectSpace(velocity)

                -- แรงหมุนกล้อง (ให้หน้าอกทิ้งน้ำหนักตามการสะบัดกล้อง)
                local camRotDelta = (currentCamLook - LastCameraRotation) * 5

                Spring.Target = Vector3.new(
                    math.clamp((-localVel.X * 0.015) - camRotDelta.X, -0.35, 0.35),
                    math.clamp((-localVel.Y * 0.022) - camRotDelta.Y, -0.45, 0.45),
                    math.clamp((localVel.Z * 0.015), -0.3, 0.3)
                )
            end
            LastHRPPosition = currentPos
            LastCameraRotation = currentCamLook

            local offset = Spring:Update(dt, Settings.BoobStiffness, Settings.BoobDamping)

            -- การบิดตัวละมุน (Squash & Stretch Dynamics)
            LeftWeld.C0 = BaseLeftC0 * CFrame.new(offset) * CFrame.Angles(offset.Y * 0.9, -offset.X * 0.7, offset.X * 0.3)
            RightWeld.C0 = BaseRightC0 * CFrame.new(offset) * CFrame.Angles(offset.Y * 0.9, offset.X * 0.7, -offset.X * 0.3)
        end
    else
        LastHRPPosition = nil
    end
end)

