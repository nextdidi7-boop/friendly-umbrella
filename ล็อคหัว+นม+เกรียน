--------------------------------------------------
-- Physics Spring Engine (ระบบหน้าอกเด้ง)
--------------------------------------------------
local Spring = {
    Position = Vector3.new(0,0,0),
    Velocity = Vector3.new(0,0,0),
    Target = Vector3.new(0,0,0)
}

function Spring:Update(dt, stiffness, damping)
    local force = (self.Target - self.Position) * stiffness
    self.Velocity = (self.Velocity + force * dt) * (1 - math.clamp(damping, 0, 1))
    self.Position = self.Position + self.Velocity * dt
    return self.Position
end

--------------------------------------------------
-- Realistic Boob & Jiggle Physics Logic
--------------------------------------------------
local CreatedBoobs = {}
local LeftWeld, RightWeld = nil, nil
local BaseLeftC0 = CFrame.new(-0.42, 0.22, -0.65)
local BaseRightC0 = CFrame.new(0.42, 0.22, -0.65)
local LastHRPPosition = nil

local function removeBoobs()
    for _, item in ipairs(CreatedBoobs) do
        if item and item.Parent then item:Destroy() end
    end
    CreatedBoobs = {}
    LeftWeld, RightWeld = nil, nil
end

local function createSphere(character, cframeOffset, size, color, parentWeldTo)
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if not torso then return nil end

    local part = Instance.new("Part")
    part.Shape = Enum.PartType.Ball
    part.Size = size
    part.Color = color
    part.Material = Enum.Material.SmoothPlastic
    part.CanCollide = false
    part.Massless = true
    part.Parent = character

    local weld = Instance.new("Weld")
    weld.Part0 = parentWeldTo or torso
    weld.Part1 = part
    weld.C0 = cframeOffset
    weld.Parent = part

    table.insert(CreatedBoobs, part)
    return part, weld
end

local function applyBoobs()
    removeBoobs()
    local char = LocalPlayer.Character
    if not isCharValid(char) then return end

    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local head = char:FindFirstChild("Head")
    if not torso then return end

    local skinColor = head and head.Color or torso.Color
    local pinkAreolaColor = Color3.fromRGB(255, 140, 160)
    local pinkNippleColor = Color3.fromRGB(255, 105, 135)

    local leftBreast, lW = createSphere(char, BaseLeftC0, Vector3.new(1.15, 1.15, 1.15), skinColor)
    local rightBreast, rW = createSphere(char, BaseRightC0, Vector3.new(1.15, 1.15, 1.15), skinColor)
    LeftWeld = lW
    RightWeld = rW

    createSphere(char, CFrame.new(0, 0, -0.55), Vector3.new(0.4, 0.4, 0.1), pinkAreolaColor, leftBreast)
    createSphere(char, CFrame.new(0, 0, -0.55), Vector3.new(0.4, 0.4, 0.1), pinkAreolaColor, rightBreast)

    createSphere(char, CFrame.new(0, 0, -0.58), Vector3.new(0.18, 0.18, 0.12), pinkNippleColor, leftBreast)
    createSphere(char, CFrame.new(0, 0, -0.58), Vector3.new(0.18, 0.18, 0.12), pinkNippleColor, rightBreast)
end

RunService.RenderStepped:Connect(function(dt)
    if Settings.BoobFeature and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and LeftWeld and RightWeld then
            local currentPos = hrp.Position
            if LastHRPPosition then
                local velocity = (currentPos - LastHRPPosition) / dt
                local localVel = hrp.CFrame:VectorToObjectSpace(velocity)
                
                Spring.Target = Vector3.new(
                    math.clamp(-localVel.X * 0.012, -0.25, 0.25),
                    math.clamp(-localVel.Y * 0.018, -0.35, 0.35),
                    math.clamp(localVel.Z * 0.012, -0.25, 0.25)
                )
            end
            LastHRPPosition = currentPos
            local offset = Spring:Update(dt, Settings.BoobBounceStiffness, Settings.BoobBounceDamping)
            
            LeftWeld.C0 = BaseLeftC0 * CFrame.new(offset) * CFrame.Angles(offset.Y * 0.8, -offset.X * 0.8, 0)
            RightWeld.C0 = BaseRightC0 * CFrame.new(offset) * CFrame.Angles(offset.Y * 0.8, offset.X * 0.8, 0)
        end
    else
        LastHRPPosition = nil
    end
end)

