local function removePlayerESP(p)
    if ESP_Objects[p] then
        for _, obj in pairs(ESP_Objects[p]) do
            pcall(function() obj:Remove() end)
        end
        ESP_Objects[p] = nil
    end
end

local function UpdateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            local isTeam = Settings.TeamCheck and p.Team and LocalPlayer.Team and (p.Team == LocalPlayer.Team)
            
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health > 0 and not isTeam then
                local hrp = char.HumanoidRootPart
                local head = char:FindFirstChild("Head") or hrp
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                local dist = (Camera.CFrame.Position - hrp.Position).Magnitude

                if onScreen and dist <= Settings.MaxDistance then
                    if not ESP_Objects[p] then
                        ESP_Objects[p] = {
                            Box = Drawing.new("Square"),
                            Name = Drawing.new("Text"),
                            HealthBg = Drawing.new("Square"),
                            HealthMain = Drawing.new("Square"),
                            Tracer = Drawing.new("Line")
                        }
                    end

                    local esp = ESP_Objects[p]
                    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                    local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    local h = math.abs(headPos.Y - legPos.Y)
                    local w = h / 1.8

                    -- Box
                    esp.Box.Visible = Settings.ESP_Box
                    esp.Box.Size = Vector2.new(w, h)
                    esp.Box.Position = Vector2.new(pos.X - w/2, headPos.Y)
                    esp.Box.Color = Color3.fromRGB(0, 255, 150)
                    esp.Box.Thickness = 1

                    -- Name
                    esp.Name.Visible = Settings.ESP_Name
                    esp.Name.Text = string.format("%s [%dm]", p.Name, math.floor(dist))
                    esp.Name.Size = 14
                    esp.Name.Center = true
                    esp.Name.Outline = true
                    esp.Name.Position = Vector2.new(pos.X, headPos.Y - 16)
                    esp.Name.Color = Color3.fromRGB(255, 255, 255)

                    -- Health Bar
                    local hpPct = math.clamp(char.Humanoid.Health / char.Humanoid.MaxHealth, 0, 1)
                    esp.HealthBg.Visible = Settings.ESP_Health
                    esp.HealthBg.Size = Vector2.new(3, h)
                    esp.HealthBg.Position = Vector2.new((pos.X - w/2) - 5, headPos.Y)
                    esp.HealthBg.Filled = true
                    esp.HealthBg.Color = Color3.fromRGB(0,0,0)

                    esp.HealthMain.Visible = Settings.ESP_Health
                    esp.HealthMain.Size = Vector2.new(1, h * hpPct)
                    esp.HealthMain.Position = Vector2.new((pos.X - w/2) - 4, headPos.Y + (h * (1 - hpPct)))
                    esp.HealthMain.Filled = true
                    esp.HealthMain.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), hpPct)

                    -- Tracer
                    esp.Tracer.Visible = Settings.ESP_Tracers
                    esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    esp.Tracer.To = Vector2.new(pos.X, pos.Y)
                    esp.Tracer.Color = Color3.fromRGB(255, 255, 255)
                    esp.Tracer.Thickness = 1
                else
                    removePlayerESP(p)
                end
            else
                removePlayerESP(p)
            end
        else
            removePlayerESP(p)
        end
    end
end

Players.PlayerRemoving:Connect(removePlayerESP)

--------------------------------------------------
-- ระบบค้นหาเป้าหมาย (Aim Logic)
--------------------------------------------------
local function GetTarget()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest, targetPart = math.huge, nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local isTeam = Settings.TeamCheck and p.Team and LocalPlayer.Team and (p.Team == LocalPlayer.Team)
            local char = p.Character
            if char and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health > 0 and not isTeam then
                local part = char:FindFirstChild(Settings.TargetPart) or char:FindFirstChild("Head")
                if part then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local mDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if mDist <= Settings.FOV and mDist < closest then
                            closest = mDist
                            targetPart = part
                        end
                    end
                end
            end
        end
    end
    return targetPart
end

--------------------------------------------------
-- Silent Aim Hook
--------------------------------------------------
local gmt = getrawmetatable and getrawmetatable(game)
if gmt and setreadonly then
    local oldIdx = gmt.__index
    setreadonly(gmt, false)
    gmt.__index = newcclosure(function(self, idx)
        if not checkcaller() and Settings.SilentAim and CurrentTarget then
            if idx == "Hit" or idx == "CFrame" then
                return CFrame.new(CurrentTarget.Position)
            elseif idx == "Target" then
                return CurrentTarget
            end
        end
        return oldIdx(self, idx)
    end)
    setreadonly(gmt, true)
end

