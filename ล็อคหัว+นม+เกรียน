--------------------------------------------------
-- REALISTIC SOFT BOOB PHYSICS (แก้ไขสปริงและน้ำหนักเหวี่ยง)
--------------------------------------------------
local CreatedBoobs = {}
local LeftWeld, RightWeld = nil, nil
local BaseLeftC0 = CFrame.new(-0.43, 0.15, -0.55)
local BaseRightC0 = CFrame.new(0.43, 0.15, -0.55)

local PhysPos = Vector3.new(0,0,0)
local PhysVel = Vector3.new(0,0,0)
local LastCharPos = nil

local function removeBoobs()
    for _, v in ipairs(CreatedBoobs) do
        if v and v.Parent then v:Destroy() end
    end
    CreatedBoobs = {}
    LeftWeld, RightWeld = nil, nil
end

local function makePart(char, cf, sz, col, parentWeld)
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then return nil end

    local p = Instance.new("Part")
    p.Shape = Enum.PartType.Ball
    p.Size = sz
    p.Color = col
    p.Material = Enum.Material.SmoothPlastic
    p.CanCollide = false
    p.Massless = true
    p.Parent = char

    local w = Instance.new("Weld")
    w.Part0 = parentWeld or torso
    w.Part1 = p
    w.C0 = cf
    w.Parent = p

    table.insert(CreatedBoobs, p)
    return p, w
end

local function applyBoobs()
    removeBoobs()
    local char = LocalPlayer.Character
    if not char or not char.Parent then return end

    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then return end

    local skinCol = head and head.Color or torso.Color
    local pink1 = Color3.fromRGB(255, 140, 160)
    local pink2 = Color3.fromRGB(255, 90, 125)
    local s = Settings.BoobSize

    -- ฐานเต้าทรงหยดน้ำซ้อนเพื่อให้ดูนุ่มละมุน
    local lMain, lW = makePart(char, BaseLeftC0, Vector3.new(1.1 * s, 1.25 * s, 1.2 * s), skinCol)
    local rMain, rW = makePart(char, BaseRightC0, Vector3.new(1.1 * s, 1.25 * s, 1.2 * s), skinCol)
    LeftWeld = lW
    RightWeld = rW

    makePart(char, CFrame.new(0, -0.15 * s, 0.05 * s), Vector3.new(1.0 * s, 1.0 * s, 1.1 * s), skinCol, lMain)
    makePart(char, CFrame.new(0, -0.15 * s, 0.05 * s), Vector3.new(1.0 * s, 1.0 * s, 1.1 * s), skinCol, rMain)

    -- ปานนมและหัวนม
    makePart(char, CFrame.new(0, 0, -0.58 * s), Vector3.new(0.4 * s, 0.4 * s, 0.08 * s), pink1, lMain)
    makePart(char, CFrame.new(0, 0, -0.58 * s), Vector3.new(0.4 * s, 0.4 * s, 0.08 * s), pink1, rMain)
    makePart(char, CFrame.new(0, 0, -0.61 * s), Vector3.new(0.16 * s, 0.16 * s, 0.1 * s), pink2, lMain)
    makePart(char, CFrame.new(0, 0, -0.61 * s), Vector3.new(0.16 * s, 0.16 * s, 0.1 * s), pink2, rMain)
end

-- คำนวณฟิสิกส์การทิ้งน้ำหนักและเด้งละมุน
RunService.RenderStepped:Connect(function(dt)
    if Settings.BoobFeature and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and LeftWeld and RightWeld then
            local pos = hrp.Position
            if LastCharPos then
                local deltaPos = (pos - LastCharPos)
                local moveVel = hrp.CFrame:VectorToObjectSpace(deltaPos / dt)
                
                local targetOff = Vector3.new(
                    math.clamp(-moveVel.X * 0.015, -0.4, 0.4),
                    math.clamp(-moveVel.Y * 0.025, -0.5, 0.5),
                    math.clamp(moveVel.Z * 0.015, -0.3, 0.3)
                )

                local force = (targetOff - PhysPos) * Settings.BoobStiffness
                PhysVel = (PhysVel + force * dt) * (1 - math.clamp(Settings.BoobDamping, 0, 1))
                PhysPos = PhysPos + PhysVel * dt
            end
            LastCharPos = pos

            LeftWeld.C0 = BaseLeftC0 * CFrame.new(PhysPos) * CFrame.Angles(PhysPos.Y * 0.8, -PhysPos.X * 0.7, PhysPos.X * 0.3)
            RightWeld.C0 = BaseRightC0 * CFrame.new(PhysPos) * CFrame.Angles(PhysPos.Y * 0.8, PhysPos.X * 0.7, -PhysPos.X * 0.3)
        end
    else
        LastCharPos = nil
    end--[[ 
    ส่วนที่ 2/2: Target Lock, Fixed Drawing ESP & Interface
]]

