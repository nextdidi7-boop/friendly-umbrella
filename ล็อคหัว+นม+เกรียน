RunService.RenderStepped:Connect(function()
    CurrentTarget = getTarget()

    FOVCircle.Visible = Settings.ShowFOV
    FOVCircle.Radius = Settings.FOV
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Color = Settings.RainbowFOV and rainbowColor(0.5) or Settings.FOVColor

    if Settings.CameraLock and CurrentTarget then
        local targetCFrame = CFrame.new(Camera.CFrame.Position, CurrentTarget.Position)
        Camera.CFrame = Settings.SmoothLock and Camera.CFrame:Lerp(targetCFrame, Settings.Smoothness) or targetCFrame
    end

    local char = LocalPlayer.Character
    if isCharValid(char) then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if Settings.SpeedHack then hum.WalkSpeed = Settings.WalkSpeedValue end
            if Settings.JumpHack then hum.JumpPower = Settings.JumpPowerValue end
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if Settings.Spinbot and hrp then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Settings.SpinSpeed), 0)
        end

        local head = char:FindFirstChild("Head")
        if head then
            if Settings.BigHead then
                if not OriginalHeadSizes[head] then OriginalHeadSizes[head] = head.Size end
                head.Size = Vector3.new(Settings.HeadSize, Settings.HeadSize, Settings.HeadSize)
            elseif OriginalHeadSizes[head] then
                head.Size = OriginalHeadSizes[head]
                OriginalHeadSizes[head] = nil
            end
        end
    end
end)

