--------------------------------------------------
-- Cleanup Logic
--------------------------------------------------
local function clearHighlight(char)
    if HIGHLIGHT_CACHE[char] then
        pcall(function() HIGHLIGHT_CACHE[char]:Destroy() end)
        HIGHLIGHT_CACHE[char] = nil
    end
end

local function clearChams(char)
    if CHAMS_CACHE[char] then
        for _, part in ipairs(CHAMS_CACHE[char]) do
            pcall(function() part:Destroy() end)
        end
        CHAMS_CACHE[char] = nil
    end
end

local function clearTracer(char)
    if TRACER_CACHE[char] then
        pcall(function() TRACER_CACHE[char]:Remove() end)
        TRACER_CACHE[char] = nil
    end
end

local function clearESP(char)
    local cache = ESP_CACHE[char]
    if cache then
        pcall(function()
            if cache.Text then cache.Text:Remove() end
            if cache.Box then cache.Box:Remove() end
            if cache.HealthBg then cache.HealthBg:Remove() end
            if cache.HealthMain then cache.HealthMain:Remove() end
        end)
        ESP_CACHE[char] = nil
    end
    clearHighlight(char)
    clearChams(char)
    clearTracer(char)
end

--------------------------------------------------
-- Target Acquisition
--------------------------------------------------
local function getTarget()
    if Settings.StickyTarget and LockedTarget and isCharValid(LockedTarget.Parent) then
        local hum = LockedTarget.Parent:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then return LockedTarget end
    end

    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest, targetPart = math.huge, nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not isTeammate(p) then
            local char = p.Character
            if isCharValid(char) and isAlive(char) then
                local part = getChosenPart(char)
                local hrp = char:FindFirstChild("HumanoidRootPart")

                if part and hrp then
                    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                    if dist <= Settings.MaxDistance and isVisible(part, char) then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                            if mouseDist < Settings.FOV and mouseDist < closest then
                                closest = mouseDist
                                targetPart = part
                            end
                        end
                    end
                end
            end
        end
    end

    if Settings.StickyTarget then LockedTarget = targetPart end
    return targetPart
end

