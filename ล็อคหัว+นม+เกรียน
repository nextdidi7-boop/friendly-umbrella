--------------------------------------------------
-- Helpers & Target Selection
--------------------------------------------------
local function isAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isTeammate(p)
    if not Settings.TeamCheck then return false end
    return p.Team and LocalPlayer.Team and (p.Team == LocalPlayer.Team)
end

local function rainbowColor(speed)
    return Color3.fromHSV((tick() * speed) % 1, 1, 1)
end

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude
RayParams.IgnoreWater = true

local function isVisible(part, char)
    if not Settings.WallCheck then return true end
    RayParams.FilterDescendantsInstances = {LocalPlayer.Character, char}
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    return Workspace:Raycast(origin, dir, RayParams) == nil
end

local function getChosenPart(char)
    if not char then return nil end
    if Settings.TargetPart == "Random" then
        local parts = {"Head", "HumanoidRootPart", "UpperTorso"}
        local valid = {}
        for _, name in ipairs(parts) do
            local p = char:FindFirstChild(name)
            if p then table.insert(valid, p) end
        end
        return #valid > 0 and valid[math.random(1, #valid)] or char:FindFirstChild("Head")
    end
    return char:FindFirstChild(Settings.TargetPart) or char:FindFirstChild("Head")
end

local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.Filled = false
FOVCircle.NumSides = 60
FOVCircle.Visible = false

local function clearHighlight(char)
    if HIGHLIGHT_CACHE[char] then
        pcall(function() HIGHLIGHT_CACHE[char]:Destroy() end)
        HIGHLIGHT_CACHE[char] = nil
    end
end

local function clearTracer(char)
    if TRACER_CACHE[char] then
        pcall(function() TRACER_CACHE[char]:Remove() end)
        TRACER_CACHE[char] = nil
    end
end

local function clearESP(char)
    local cache = ESP_CACHE[char]
    if cache then
        pcall(function()
            if cache.Text then cache.Text:Remove() end
            if cache.Box then cache.Box:Remove() end
            if cache.HealthBg then cache.HealthBg:Remove() end
            if cache.HealthMain then cache.HealthMain:Remove() end
        end)
        ESP_CACHE[char] = nil
    end
    clearHighlight(char)
    clearTracer(char)
end

local function getTarget()
    if Settings.StickyTarget and LockedTarget and isCharValid(LockedTarget.Parent) then
        local hum = LockedTarget.Parent:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then return LockedTarget end
    end

    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest, targetPart = math.huge, nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not isTeammate(p) then
            local char = p.Character
            if isCharValid(char) and isAlive(char) then
                local part = getChosenPart(char)
                local hrp = char:FindFirstChild("HumanoidRootPart")

                if part and hrp then
                    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                    if dist <= Settings.MaxDistance and isVisible(part, char) then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                            if mouseDist < Settings.FOV and mouseDist < closest then
                                closest = mouseDist
                                targetPart = part
                            end
                        end
                    end
                end
            end
        end
    end

    if Settings.StickyTarget then LockedTarget = targetPart end
    return targetPart
end

--------------------------------------------------
-- Silent Aim Engine
--------------------------------------------------
local RawMeta = getrawmetatable or debug.getmetatable
if RawMeta and setreadonly then
    local gmt = RawMeta(game)
    local oldIndex = gmt.__index
    setreadonly(gmt, false)

    gmt.__index = newcclosure(function(self, idx)
        if not checkcaller() and Settings.SilentAim and CurrentTarget then
            local targetPos = CurrentTarget.Position
            if Settings.Prediction and CurrentTarget.Parent then
                local hrp = CurrentTarget.Parent:FindFirstChild("HumanoidRootPart")
                if hrp then targetPos = targetPos + (hrp.Velocity * Settings.PredictionVelocity) end
            end

            if idx == "Hit" or idx == "CFrame" then
                return CFrame.new(targetPos)
            elseif idx == "Target" then
                return CurrentTarget
            end
        end
        return oldIndex(self, idx)
    end)
    setreadonly(gmt, true)
end

