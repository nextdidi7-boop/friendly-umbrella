-- NPC ESP
local function NPC_ESP_SYSTEM()
    if not ESP_NPC_ENABLED then
        for model, textObj in pairs(NPC_CACHE) do
            pcall(function() textObj:Remove() end)
        end
        NPC_CACHE = {}
        return
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
            if hrp then
                if not NPC_CACHE[obj] then
                    local t = Drawing.new("Text")
                    t.Center = true
                    t.Outline = true
                    t.Font = 2
                    t.Size = 13
                    t.Color = Color3.fromRGB(0, 255, 150)
                    NPC_CACHE[obj] = t
                end

                local pos, on = Camera:WorldToViewportPoint(hrp.Position)
                if on then
                    NPC_CACHE[obj].Text = "[NPC] " .. obj.Name
                    NPC_CACHE[obj].Position = Vector2.new(pos.X, pos.Y - 20)
                    NPC_CACHE[obj].Visible = true
                else
                    NPC_CACHE[obj].Visible = false
                end
            end
        end
    end
end

-- Server Hop (Low Player Count)
local function joinLowPlayerServer()
    local api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(api))
    end)
    if success and result and result.data then
        for _, server in ipairs(result.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                break
            end
        end
    end
end

