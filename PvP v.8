_G.DestroyBoobs = function()
    for _, v in ipairs(CreatedBoobParts) do
        if v and v.Parent then pcall(function() v:Destroy() end) end
    end
    CreatedBoobParts = {}
    LeftMeshWeld, RightMeshWeld = nil, nil
end

_G.BuildSoftBoob = function(char)
    _G.DestroyBoobs()
    if not char or not char.Parent then return end

    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local head = char:FindFirstChild("Head")
    if not torso then return end

    local skinCol = head and head.Color or torso.Color
    local pink1, pink2 = Color3.fromRGB(255, 130, 155), Color3.fromRGB(255, 80, 120)
    local s = _G.BoobSettings.Size

    local function createSphere(cf, size, col, parentWeld)
        local p = Instance.new("Part")
        p.Shape = Enum.PartType.Ball
        p.Size = size
        p.Color = col
        p.Material = Enum.Material.SmoothPlastic
        p.CanCollide = false
        p.Massless = true
        p.Parent = char

        local w = Instance.new("Weld")
        w.Part0 = parentWeld or torso
        w.Part1 = p
        w.C0 = cf
        w.Parent = p

        table.insert(CreatedBoobParts, p)
        return p, w
    end

    local lMain, lW = createSphere(BaseLeftC0, Vector3.new(1.05 * s, 1.25 * s, 1.15 * s), skinCol)
    local rMain, rW = createSphere(BaseRightC0, Vector3.new(1.05 * s, 1.25 * s, 1.15 * s), skinCol)
    LeftMeshWeld, RightMeshWeld = lW, rW

    createSphere(CFrame.new(0, -0.18 * s, 0.08 * s), Vector3.new(0.95 * s, 0.95 * s, 1.05 * s), skinCol, lMain)
    createSphere(CFrame.new(0, -0.18 * s, 0.08 * s), Vector3.new(0.95 * s, 0.95 * s, 1.05 * s), skinCol, rMain)
    createSphere(CFrame.new(0, -0.02 * s, -0.55 * s), Vector3.new(0.38 * s, 0.38 * s, 0.08 * s), pink1, lMain)
    createSphere(CFrame.new(0, -0.02 * s, -0.55 * s), Vector3.new(0.38 * s, 0.38 * s, 0.08 * s), pink1, rMain)
    createSphere(CFrame.new(0, -0.02 * s, -0.58 * s), Vector3.new(0.15 * s, 0.15 * s, 0.1 * s), pink2, lMain)
    createSphere(CFrame.new(0, -0.02 * s, -0.58 * s), Vector3.new(0.15 * s, 0.15 * s, 0.1 * s), pink2, rMain)
end

