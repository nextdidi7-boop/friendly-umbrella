-- สีระดับความแรร์ 5 ระดับ (1.เทา 2.ฟ้า 3.ม่วง 4.ทอง 5.แดง)
local RARITY_COLORS = {
    [1] = Color3.fromRGB(180, 180, 180),
    [2] = Color3.fromRGB(0, 170, 255),
    [3] = Color3.fromRGB(170, 0, 255),
    [4] = Color3.fromRGB(255, 200, 0),
    [5] = Color3.fromRGB(255, 30, 30),
    
    ["Common"]    = Color3.fromRGB(180, 180, 180),
    ["Uncommon"]  = Color3.fromRGB(180, 180, 180),
    ["Rare"]      = Color3.fromRGB(0, 170, 255),
    ["Epic"]      = Color3.fromRGB(170, 0, 255),
    ["Legendary"] = Color3.fromRGB(255, 200, 0),
    ["Mythic"]    = Color3.fromRGB(255, 30, 30),
    
    ["Default"]   = Color3.fromRGB(255, 255, 255)
}

-- ฟังก์ชันดึงชื่อไอเทมจริง (แก้ปัญหาแสดงผลเป็นตัวเลข ID)
local function GetItemName(tool)
    if not tool then return "Unknown" end
    
    -- เช็ค Attribute หรือค่าภายใน
    local nameAttr = tool:GetAttribute("ItemName") or tool:GetAttribute("DisplayName") or tool:GetAttribute("Name")
    if nameAttr and tostring(nameAttr) ~= "" and tostring(nameAttr) ~= tostring(tool.Name) then 
        return tostring(nameAttr) 
    end
    
    local nameObj = tool:FindFirstChild("ItemName") or tool:FindFirstChild("DisplayName") or tool:FindFirstChild("Title")
    if nameObj and nameObj:IsA("ValueBase") and tostring(nameObj.Value) ~= "" then
        return tostring(nameObj.Value)
    end
    
    -- ถ้าชื่อหลักเป็นตัวเลข ให้พยายามหา StringValue อื่นๆ ข้างใน
    if tonumber(tool.Name) then
        for _, child in ipairs(tool:GetChildren()) do
            if child:IsA("StringValue") and child.Name ~= "Rarity" and child.Name ~= "Tier" then
                return child.Value
            end
        end
    end
    
    return tool.Name
end

local function GetItemColor(tool)
    if not tool then return RARITY_COLORS["Default"] end
    
    local rarityVal = tool:GetAttribute("Rarity") or tool:GetAttribute("Tier") or tool:GetAttribute("RarityLevel")
    if not rarityVal then
        local child = tool:FindFirstChild("Rarity") or tool:FindFirstChild("Tier") or tool:FindFirstChild("RarityLevel")
        if child and child:IsA("ValueBase") then
            rarityVal = child.Value
        end
    end
    
    if rarityVal then
        local numRarity = tonumber(rarityVal)
        if numRarity and RARITY_COLORS[numRarity] then
            return RARITY_COLORS[numRarity]
        end
        if RARITY_COLORS[tostring(rarityVal)] then
            return RARITY_COLORS[tostring(rarityVal)]
        end
    end
    
    return RARITY_COLORS["Default"]
end

local function RemovePlayerESP(Player)
    local Folder = PlayerESPFolder:FindFirstChild(tostring(Player.UserId))
    if Folder then Folder:Destroy() end
    if HIGHLIGHT_CACHE[Player] then
        pcall(function() HIGHLIGHT_CACHE[Player]:Destroy() end)
        HIGHLIGHT_CACHE[Player] = nil
    end
end

local function CreatePlayerESP(Player)
    if Player == LocalPlayer then return end
    local Character = Player.Character
    if not Character or not isAlive(Character) then return end
    local RootPart = Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChild("Torso")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not RootPart or not Humanoid then return end

    RemovePlayerESP(Player)

    local Folder = Instance.new("Folder", PlayerESPFolder)
    Folder.Name = tostring(Player.UserId)

    if _G.Settings.HighlightESP or _G.Settings.RainbowESP then
        local Highlight = Instance.new("Highlight")
        Highlight.Name = "PlayerHighlight"
        Highlight.Adornee = Character
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        Highlight.FillTransparency = 0.75
        Highlight.OutlineTransparency = 0
        Highlight.FillColor = Color3.fromRGB(255, 0, 0)
        Highlight.OutlineColor = _G.Settings.RainbowESP and GetRainbow(0.25) or Color3.fromRGB(255, 255, 255)
        Highlight.Parent = Folder
        HIGHLIGHT_CACHE[Player] = Highlight
    end

    if _G.Settings.NameESP or _G.Settings.HealthESP or _G.Settings.ToolESP then
        local Billboard = Instance.new("BillboardGui", Folder)
        Billboard.Name = "PlayerInfo"
        Billboard.Adornee = RootPart -- ย้ายมาติดที่กลางตัว
        Billboard.AlwaysOnTop = true
        Billboard.Size = UDim2.fromOffset(220, 160)
        Billboard.StudsOffset = Vector3.new(0, 0.5, 0) -- ปรับให้อยู่บริเวณกลางลำตัว

        local Container = Instance.new("Frame", Billboard)
        Container.BackgroundTransparency = 1
        Container.Size = UDim2.fromScale(1, 1)

        local Layout = Instance.new("UIListLayout", Container)
        Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        Layout.VerticalAlignment = Enum.VerticalAlignment.Top
        Layout.Padding = UDim.new(0, 1)

        -- 1. แสดงชื่อผู้เล่น (ถ้าเป็นพันธมิตรจะเปลี่ยนเป็นสีเขียว)
        if _G.Settings.NameESP then
            local NameLabel = Instance.new("TextLabel", Container)
            NameLabel.BackgroundTransparency = 1
            NameLabel.Size = UDim2.fromOffset(210, 18)
            NameLabel.Text = Player.DisplayName .. " (@" .. Player.Name .. ")"
            NameLabel.TextColor3 = isFriendly(Player) and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 255, 255)
            NameLabel.TextStrokeTransparency = 0
            NameLabel.TextScaled = true
            NameLabel.Font = Enum.Font.GothamBold

            -- อัปเดตสีชื่ออัตโนมัติหากมีการเปลี่ยนสถานะพันธมิตร
            task.spawn(function()
                while NameLabel and NameLabel.Parent do
                    NameLabel.TextColor3 = isFriendly(Player) and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 255, 255)
                    task.wait(1)
                end
            end)
        end

        -- 2. แสดงระยะห่างและเปอร์เซ็นต์เลือด
        local InfoLabel = Instance.new("TextLabel", Container)
        InfoLabel.BackgroundTransparency = 1
        InfoLabel.Size = UDim2.fromOffset(210, 16)
        InfoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        InfoLabel.TextStrokeTransparency = 0
        InfoLabel.TextScaled = true
        InfoLabel.Font = Enum.Font.GothamBold

        local function UpdateInfo()
            if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
            local myPos = LocalPlayer.Character.HumanoidRootPart.Position
            local dist = math.floor((RootPart.Position - myPos).Magnitude)
            local hpPercent = math.floor((Humanoid.Health / math.max(Humanoid.MaxHealth, 1)) * 100)
            
            if _G.Settings.HealthESP then
                InfoLabel.Text = "[" .. dist .. "M] [" .. hpPercent .. "%]"
            else
                InfoLabel.Text = "[" .. dist .. "M]"
            end
        end

        UpdateInfo()
        
        local conn
        conn = RunService.RenderStepped:Connect(function()
            if not Billboard or not Billboard.Parent then
                if conn then conn:Disconnect() end
                return
            end
            UpdateInfo()
        end)

        -- 3. แสดงชื่อไอเทมเรียงลงมาตามสีความแรร์
        if _G.Settings.ToolESP then
            local ToolContainer = Instance.new("Frame", Container)
            ToolContainer.Name = "ToolContainer"
            ToolContainer.BackgroundTransparency = 1
            ToolContainer.Size = UDim2.fromOffset(210, 90)

            local ToolLayout = Instance.new("UIListLayout", ToolContainer)
            ToolLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            ToolLayout.VerticalAlignment = Enum.VerticalAlignment.Top
            ToolLayout.Padding = UDim.new(0, 1)

            local function UpdateTools()
                for _, child in ipairs(ToolContainer:GetChildren()) do
                    if child:IsA("TextLabel") then child:Destroy() end
                end

                local toolList = {}

                for _, obj in ipairs(Character:GetChildren()) do
                    if obj:IsA("Tool") then
                        table.insert(toolList, obj)
                    end
                end

                local backpack = Player:FindFirstChildOfClass("Backpack")
                if backpack then
                    for _, obj in ipairs(backpack:GetChildren()) do
                        if obj:IsA("Tool") then
                            table.insert(toolList, obj)
                        end
                    end
                end

                for _, toolObj in ipairs(toolList) do
                    local realName = GetItemName(toolObj)
                    local itemColor = GetItemColor(toolObj)

                    local Label = Instance.new("TextLabel", ToolContainer)
                    Label.BackgroundTransparency = 1
                    Label.Size = UDim2.fromOffset(210, 15)
                    Label.Text = realName
                    Label.TextColor3 = itemColor
                    Label.TextStrokeTransparency = 0
                    Label.TextScaled = true
                    Label.Font = Enum.Font.GothamBold
                end
            end

            UpdateTools()

            Character.ChildAdded:Connect(function(o) if o:IsA("Tool") then task.wait(0.1); UpdateTools() end end)
            Character.ChildRemoved:Connect(function(o) if o:IsA("Tool") then task.wait(0.1); UpdateTools() end end)
            
            local backpack = Player:FindFirstChildOfClass("Backpack")
            if backpack then
                backpack.ChildAdded:Connect(function(o) if o:IsA("Tool") then task.wait(0.1); UpdateTools() end end)
                backpack.ChildRemoved:Connect(function(o) if o:IsA("Tool") then task.wait(0.1); UpdateTools() end end)
            end
        end
    end
end

_G.RefreshPlayerESP = function()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            if Player.Character then CreatePlayerESP(Player) end
            Player.CharacterAdded:Connect(function()
                task.wait(0.5)
                if Player.Character then CreatePlayerESP(Player) end
            end)
        end
    end
end

RunService.Stepped:Connect(function()
    if _G.Settings.WalkSpeedEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = _G.Settings.WalkSpeedVal end
    end
end)

RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = _G.Settings.FOVEnabled
    local Size = math.clamp(_G.Settings.FOVSize, 1, 300)
    FOVCircle.Size = UDim2.fromOffset(Size * 2, Size * 2)
    FOVStroke.Color = _G.Settings.RainbowFOV and GetRainbow(1) or Color3.fromRGB(255, 255, 255)

    local Target = GetClosestTarget()

    if Target then
        if _G.Settings.AimbotEnabled then
            local CurrentCF = Camera.CFrame
            local TargetCF = CFrame.lookAt(CurrentCF.Position, Target.Position)
            Camera.CFrame = CurrentCF:Lerp(TargetCF, _G.Settings.Smoothness)
        end

        if _G.Settings.CameraLock then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Target.Position)
        end

        if _G.Settings.AutoShootOnTarget then
            local tool = getEquippedTool()
            if tool then
                tool:Activate()
            end
        end
    end

    if _G.Settings.RainbowESP then
        for _, h in pairs(HIGHLIGHT_CACHE) do
            if h then h.OutlineColor = GetRainbow(0.25) end
        end
    end

    if _G.Settings.FullbrightEnabled then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
    end
end)

