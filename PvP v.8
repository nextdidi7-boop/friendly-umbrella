local CreatedBoobParts = {}
local LeftMeshWeld, RightMeshWeld = nil, nil
local BaseLeftC0 = CFrame.new(-0.42, 0.1, -0.52)
local BaseRightC0 = CFrame.new(0.42, 0.1, -0.52)

local function GetRainbow(speed)
    local t = (tick() * (speed or 1)) % 5 / 5
    return Color3.fromHSV(t, 1, 1)
end

local function isAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isTeammate(p)
    if not _G.Settings.TeamCheck then return false end
    if not LocalPlayer.Team or not p.Team then return false end
    return p.Team == LocalPlayer.Team
end

-- ตรวจสอบว่าเป็นผู้เล่นพันธมิตรที่เลือกไว้หรือไม่
local function isFriendly(p)
    if _G.FriendlyPlayers[p.Name] or _G.FriendlyPlayers[tostring(p.UserId)] then
        return true
    end
    return false
end

-- ตรวจสอบว่าอยู่ในเซฟโซนหรือไม่ (เช็คจาก Attribute หรือ Folder Safezone ในแมพ)
local function isInSafezone(char)
    if not char then return false end
    if char:GetAttribute("Safezone") or char:GetAttribute("InSafezone") then
        return true
    end
    -- เช็คเผื่อแมพใช้เงื่อนไขอื่น เช่น Touching Safezone Part
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        for _, part in ipairs(Workspace:GetPartsInPart(root)) do
            if part.Name:lower():find("safe") or part.Parent.Name:lower():find("safe") then
                return true
            end
        end
    end
    return false
end

local function getEquippedTool()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
end

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Blacklist
RayParams.IgnoreWater = true

local function isVisible(part, char)
    RayParams.FilterDescendantsInstances = {LocalPlayer.Character, char}
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    return not Workspace:Raycast(origin, dir, RayParams)
end

local function GetClosestTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local closest, target = _G.Settings.FOVSize, nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and isAlive(p.Character) and not isTeammate(p) then
            -- ถ้าอยู่ในพันธมิตร หรืออยู่ในเซฟโซน จะข้ามไม่ล็อคเป้า
            if not isFriendly(p) and not (_G.Settings.SafezoneCheck and isInSafezone(p.Character)) then
                local part = p.Character:FindFirstChild(_G.Settings.AimPart) or p.Character:FindFirstChild("Head")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if part and hrp and (Camera.CFrame.Position - hrp.Position).Magnitude <= _G.Settings.MaxDistance then
                    if isVisible(part, p.Character) then
                        local s, on = Camera:WorldToViewportPoint(part.Position)
                        if on then
                            local d = (Vector2.new(s.X, s.Y) - center).Magnitude
                            if d < closest then
                                closest = d
                                target = part
                            end
                        end
                    end
                end
            end
        end
    end
    return target
end

