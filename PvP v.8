-- ระบบ Save / Load Config
local ConfigFileName = "nextshopPvP_Config.json"

local function SaveConfig()
    pcall(function()
        local dataToSave = {
            Settings = _G.Settings,
            BoobSettings = _G.BoobSettings,
            FriendlyPlayers = _G.FriendlyPlayers
        }
        writefile(ConfigFileName, HttpService:JSONEncode(dataToSave))
    end)
end

local function LoadConfig()
    pcall(function()
        if isfile and isfile(ConfigFileName) then
            local fileData = readfile(ConfigFileName)
            local decoded = HttpService:JSONDecode(fileData)
            
            if decoded.Settings then
                for k, v in pairs(decoded.Settings) do
                    _G.Settings[k] = v
                end
            end
            if decoded.BoobSettings then
                for k, v in pairs(decoded.BoobSettings) do
                    _G.BoobSettings[k] = v
                end
            end
            if decoded.FriendlyPlayers then
                _G.FriendlyPlayers = decoded.FriendlyPlayers
            end
        end
    end)
end

LoadConfig()
