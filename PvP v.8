_G.joinLowPlayerServer = function()
    local placeId = game.PlaceId
    local cursor = ""
    local lowestServer = nil
    local minPlayers = math.huge

    pcall(function()
        repeat
            local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
            local response = HttpService:JSONDecode(game:HttpGet(url))
            if response and response.data then
                for _, server in ipairs(response.data) do
                    if server.id ~= game.JobId and server.playing < server.maxPlayers then
                        if server.playing < minPlayers then
                            minPlayers = server.playing
                            lowestServer = server.id
                        end
                    end
                end
                cursor = response.nextPageCursor or ""
            else
                break
            end
        until lowestServer or not cursor or cursor == ""

        if lowestServer then
            TeleportService:TeleportToPlaceInstance(placeId, lowestServer, LocalPlayer)
        end
    end)
end
