-- ระบบย้ายไปเซิร์ฟเวอร์ที่มีผู้เล่นน้อย
--========================================================

_G.joinLowPlayerServer = function()
    local baseUrl =
        "https://games.roblox.com/v1/games/"
        .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"

    local cursor = nil
    local bestServer = nil
    local bestPlayers = math.huge

    for _ = 1, 5 do
        local url =
            baseUrl
            .. (
                cursor
                and "&cursor="
                    .. HttpService:UrlEncode(cursor)
                or ""
            )

        local success, result =
            pcall(
                function()
                    return HttpService:JSONDecode(
                        game:HttpGet(url)
                    )
                end
            )

        if not success
            or not result
            or not result.data then
            break
        end

        for _, server in ipairs(result.data) do
            if server.id ~= game.JobId
                and tonumber(server.playing)
                and tonumber(server.maxPlayers)
                and server.playing < server.maxPlayers
                and server.playing < bestPlayers then

                bestServer = server
                bestPlayers = server.playing
            end
        end

        cursor = result.nextPageCursor

        if not cursor then
            break
        end
    end

    if bestServer then
        TeleportService:TeleportToPlaceInstance(
            game.PlaceId,
            bestServer.id,
            LocalPlayer
        )
    end
end
