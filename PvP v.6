-- [PART 3/3] ESP SYSTEM, UPDATER LOOPS & SERVER HOP
--========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local Camera = Workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local GetRainbow = _G.GetRainbow
local isAlive = _G.isAlive
local isTeammate = _G.isTeammate
local getEquippedTool = _G.getEquippedTool
local fireGun = _G.fireGun
local GetClosestTarget = _G.GetClosestTarget

local PlayerESPFolder = _G.PlayerESPFolder
local FOVStroke = _G.FOVStroke
local FOVCircle = _G.FOVCircle

local HIGHLIGHT_CACHE = {}

local function RemovePlayerESP(Player)
    local Folder = PlayerESPFolder:FindFirstChild(tostring(Player.UserId))
    if Folder then Folder:Destroy() end
    if HIGHLIGHT_CACHE[Player] then
        pcall(function() HIGHLIGHT_CACHE[Player]:Destroy() end)
        HIGHLIGHT_CACHE[Player] = nil
    end
end

local function CreatePlayerESP(Player)
    if Player == LocalPlayer then return end
    local Character = Player.Character
    if not Character or not isAlive(Character) then return end
    local Head = Character:FindFirstChild("Head")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Head or not Humanoid then return end

    RemovePlayerESP(Player)

    local Folder = Instance.new("Folder", PlayerESPFolder)
    Folder.Name = tostring(Player.UserId)

    if _G.Settings.HighlightESP or _G.Settings.RainbowESP then
        local Highlight = Instance.new("Highlight")
        Highlight.Name = "PlayerHighlight"
        Highlight.Adornee = Character
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        Highlight.FillTransparency = 0.75
        Highlight.OutlineTransparency = 0
        Highlight.FillColor = Color3.fromRGB(255, 0, 0)
        Highlight.OutlineColor = _G.Settings.RainbowESP and GetRainbow(0.25) or Color3.fromRGB(255, 255, 255)
        Highlight.Parent = Folder
        HIGHLIGHT_CACHE[Player] = Highlight
    end

    if _G.Settings.NameESP or _G.Settings.HealthESP or _G.Settings.ToolESP then
        local Billboard = Instance.new("BillboardGui", Folder)
        Billboard.Name = "PlayerInfo"
        Billboard.Adornee = Head
        Billboard.AlwaysOnTop = true
        Billboard.Size = UDim2.fromOffset(220, 90)
        Billboard.StudsOffset = Vector3.new(0, 3, 0)

        local Container = Instance.new("Frame", Billboard)
        Container.BackgroundTransparency = 1
        Container.Size = UDim2.fromScale(1, 1)

        local Layout = Instance.new("UIListLayout", Container)
        Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        Layout.VerticalAlignment = Enum.VerticalAlignment.Center
        Layout.Padding = UDim.new(0, 2)

        if _G.Settings.NameESP then
            local NameLabel = Instance.new("TextLabel", Container)
            NameLabel.BackgroundTransparency = 1
            NameLabel.Size = UDim2.fromOffset(210, 22)
            NameLabel.Text = Player.DisplayName .. " (@" .. Player.Name .. ")"
            NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            NameLabel.TextStrokeTransparency = 0
            NameLabel.TextScaled = true
            NameLabel.Font = Enum.Font.GothamBold
        end

        if _G.Settings.HealthESP then
            local HealthBack = Instance.new("Frame", Container)
            HealthBack.Size = UDim2.fromOffset(140, 10)
            HealthBack.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            HealthBack.BorderSizePixel = 0
            Instance.new("UICorner", HealthBack).CornerRadius = UDim.new(1, 0)

            local HealthBar = Instance.new("Frame", HealthBack)
            HealthBar.Size = UDim2.fromScale(math.clamp(Humanoid.Health / math.max(Humanoid.MaxHealth, 1), 0, 1), 1)
            HealthBar.BackgroundColor3 = Color3.fromRGB(50, 255, 100)
            HealthBar.BorderSizePixel = 0
            Instance.new("UICorner", HealthBar).CornerRadius = UDim.new(1, 0)

            local HPText = Instance.new("TextLabel", Container)
            HPText.BackgroundTransparency = 1
            HPText.Size = UDim2.fromOffset(210, 18)
            HPText.Text = math.floor(Humanoid.Health) .. " / " .. math.floor(Humanoid.MaxHealth) .. " HP"
            HPText.TextColor3 = Color3.fromRGB(255, 255, 255)
            HPText.TextStrokeTransparency = 0
            HPText.TextScaled = true
            HPText.Font = Enum.Font.Gotham

            Humanoid.HealthChanged:Connect(function(Health)
                if not HealthBar.Parent then return end
                local MaxHealth = math.max(Humanoid.MaxHealth, 1)
                HealthBar.Size = UDim2.fromScale(math.clamp(Health / MaxHealth, 0, 1), 1)
                HPText.Text = math.floor(Health) .. " / " .. math.floor(MaxHealth) .. " HP"
            end)
        end

        if _G.Settings.ToolESP then
            local ToolLabel = Instance.new("TextLabel", Container)
            ToolLabel.BackgroundTransparency = 1
            ToolLabel.Size = UDim2.fromOffset(210, 20)
            ToolLabel.TextColor3 = Color3.fromRGB(255, 220, 80)
            ToolLabel.TextStrokeTransparency = 0
            ToolLabel.TextScaled = true
            ToolLabel.Font = Enum.Font.GothamBold

            local function UpdateTool()
                local t = Character:FindFirstChildOfClass("Tool")
                ToolLabel.Text = "ถือ: " .. (t and t.Name or "-")
            end
            UpdateTool()
            Character.ChildAdded:Connect(function(o) if o:IsA("Tool") then task.wait(); UpdateTool() end end)
            Character.ChildRemoved:Connect(function(o) if o:IsA("Tool") then task.wait(); UpdateTool() end end)
        end
    end
end

_G.RefreshPlayerESP = function()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            if Player.Character then CreatePlayerESP(Player) end
            Player.CharacterAdded:Connect(function()
                task.wait(0.5)
                if Player.Character then CreatePlayerESP(Player) end
            end)
        end
    end
end

RunService.Stepped:Connect(function()
    if _G.Settings.GodModeEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = hum.MaxHealth end
    end

    if _G.Settings.WalkSpeedEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = _G.Settings.WalkSpeedVal end
    end
end)

-- ลูปอัปเดตกล้องและการยิงอัตโนมัติเมื่อเล็งเป้า
RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = _G.Settings.FOVEnabled
    local Size = math.clamp(_G.Settings.FOVSize, 1, 300)
    FOVCircle.Size = UDim2.fromOffset(Size * 2, Size * 2)
    FOVStroke.Color = _G.Settings.RainbowFOV and GetRainbow(1) or Color3.fromRGB(255, 255, 255)

    local Target = GetClosestTarget()

    if Target then
        if _G.Settings.AimbotEnabled then
            local CurrentCF = Camera.CFrame
            local TargetCF = CFrame.lookAt(CurrentCF.Position, Target.Position)
            Camera.CFrame = CurrentCF:Lerp(TargetCF, _G.Settings.Smoothness)
        end

        if _G.Settings.CameraLock then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Target.Position)
        end

        -- ยิงอัตโนมัติเมื่อเล็งเป้าใส่ผู้เล่น
        if _G.Settings.AutoShootOnAim and getEquippedTool() then
            if tick() - _G.LastShootTime > _G.Settings.FireRateVal then
                _G.LastShootTime = tick()
                fireGun()
            end
        end
    end

    if _G.Settings.RainbowESP then
        for _, h in pairs(HIGHLIGHT_CACHE) do
            if h then h.OutlineColor = GetRainbow(0.25) end
        end
    end
end)

UserInputService.JumpRequest:Connect(function()
    if _G.Settings.InfiniteJumpEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

local function setupCharacterEvents(char)
    if not char then return end
    if _G.BoobSettings.Enabled then _G.BuildSoftBoob(char) end
end

if LocalPlayer.Character then setupCharacterEvents(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupCharacterEvents)

Players.PlayerAdded:Connect(function(Player)
    Player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if Player.Character then CreatePlayerESP(Player) end
    end)
end)

Players.PlayerRemoving:Connect(function(Player)
    RemovePlayerESP(Player)
end)

-- ระบบย้ายไปเซิร์ฟเวอร์คนน้อย (Server Hop)
_G.joinLowPlayerServer = function()
    local placeId = game.PlaceId
    local cursor = ""
    local found = false

    while not found do
        local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
        local success, response = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if success and response and response.data then
            for _, server in ipairs(response.data) do
                if server.playing < server.maxPlayers and server.id ~= game.JobId then
                    found = true
                    TeleportService:TeleportToPlaceInstance(placeId, server.id, LocalPlayer)
                    break
                end
            end
            if response.nextPageCursor then
                cursor = response.nextPageCursor
            else
                break
            end
        else
            break
        end
        task.wait(0.2)
    end
end
