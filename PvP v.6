-- [PART 2/3] COMBAT, AIMBOT & PHYSICS LOGIC
--========================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Camera = Workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local IsReloading = false
local LastShootTime = 0

local CreatedBoobParts = {}
local LeftMeshWeld, RightMeshWeld = nil, nil
local BaseLeftC0 = CFrame.new(-0.42, 0.1, -0.52)
local BaseRightC0 = CFrame.new(0.42, 0.1, -0.52)

local function GetRainbow(speed)
    local t = (tick() * (speed or 1)) % 5 / 5
    return Color3.fromHSV(t, 1, 1)
end

local function isAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isTeammate(p)
    if not _G.Settings.TeamCheck then return false end
    if not LocalPlayer.Team or not p.Team then return false end
    return p.Team == LocalPlayer.Team
end

local function getEquippedTool()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
end

local function GetClosestTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local closest, target = _G.Settings.FOVSize, nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and isAlive(p.Character) and not isTeammate(p) then
            local part = p.Character:FindFirstChild(_G.Settings.AimPart) or p.Character:FindFirstChild("Head")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if part and hrp and (Camera.CFrame.Position - hrp.Position).Magnitude <= _G.Settings.MaxDistance then
                local s, on = Camera:WorldToViewportPoint(part.Position)
                if on then
                    local d = (Vector2.new(s.X, s.Y) - center).Magnitude
                    if d < closest then
                        closest = d
                        target = part
                    end
                end
            end
        end
    end
    return target
end

-- ระบบยิงปืน
local function fireGun()
    if IsReloading then return end
    local tool = getEquippedTool()
    if tool then
        tool:Activate()
        local VirtualUser = game:GetService("VirtualUser")
        VirtualUser:Button1Down(Vector2.new(0, 0), Camera.CFrame)
        task.wait(_G.Settings.FireRateVal)
        VirtualUser:Button1Up(Vector2.new(0, 0), Camera.CFrame)
        tool:Deactivate()
    end
end

_G.DestroyBoobs = function()
    for _, v in ipairs(CreatedBoobParts) do
        if v and v.Parent then pcall(function() v:Destroy() end) end
    end
    CreatedBoobParts = {}
    LeftMeshWeld, RightMeshWeld = nil, nil
end

_G.BuildSoftBoob = function(char)
    _G.DestroyBoobs()
    if not char or not char.Parent then return end

    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local head = char:FindFirstChild("Head")
    if not torso then return end

    local skinCol = head and head.Color or torso.Color
    local pink1, pink2 = Color3.fromRGB(255, 130, 155), Color3.fromRGB(255, 80, 120)
    local s = _G.BoobSettings.Size

    local function createSphere(cf, size, col, parentWeld)
        local p = Instance.new("Part")
        p.Shape = Enum.PartType.Ball
        p.Size = size
        p.Color = col
        p.Material = Enum.Material.SmoothPlastic
        p.CanCollide = false
        p.Massless = true
        p.Parent = char

        local w = Instance.new("Weld")
        w.Part0 = parentWeld or torso
        w.Part1 = p
        w.C0 = cf
        w.Parent = p

        table.insert(CreatedBoobParts, p)
        return p, w
    end

    local lMain, lW = createSphere(BaseLeftC0, Vector3.new(1.05 * s, 1.25 * s, 1.15 * s), skinCol)
    local rMain, rW = createSphere(BaseRightC0, Vector3.new(1.05 * s, 1.25 * s, 1.15 * s), skinCol)
    LeftMeshWeld, RightMeshWeld = lW, rW

    createSphere(CFrame.new(0, -0.18 * s, 0.08 * s), Vector3.new(0.95 * s, 0.95 * s, 1.05 * s), skinCol, lMain)
    createSphere(CFrame.new(0, -0.18 * s, 0.08 * s), Vector3.new(0.95 * s, 0.95 * s, 1.05 * s), skinCol, rMain)
    createSphere(CFrame.new(0, -0.02 * s, -0.55 * s), Vector3.new(0.38 * s, 0.38 * s, 0.08 * s), pink1, lMain)
    createSphere(CFrame.new(0, -0.02 * s, -0.55 * s), Vector3.new(0.38 * s, 0.38 * s, 0.08 * s), pink1, rMain)
    createSphere(CFrame.new(0, -0.02 * s, -0.58 * s), Vector3.new(0.15 * s, 0.15 * s, 0.1 * s), pink2, lMain)
    createSphere(CFrame.new(0, -0.02 * s, -0.58 * s), Vector3.new(0.15 * s, 0.15 * s, 0.1 * s), pink2, rMain)
end

_G.GetRainbow = GetRainbow
