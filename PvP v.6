--========================================================
-- [PART 2/4] COMBAT, AIMBOT & PHYSICS LOGIC
--========================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualUser = game:GetService("VirtualUser")
local Camera = Workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local IsReloading = false
local IsShootingBurst = false
local LastShootTime = 0

local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude
RayParams.IgnoreWater = true

local function GetRainbow(speed)
    local t = (tick() * (speed or 1)) % 5 / 5
    return Color3.fromHSV(t, 1, 1)
end

local function isAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isTeammate(p)
    if not _G.Settings.TeamCheck then
        return false
    end

    if not LocalPlayer.Team or not p.Team then
        return false
    end

    return p.Team == LocalPlayer.Team
end

local function getEquippedTool()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
end

local function GetClosestTarget()
    local center = Vector2.new(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )

    local closest, target = _G.Settings.FOVSize, nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer
            and p.Character
            and isAlive(p.Character)
            and not isTeammate(p) then

            local part =
                p.Character:FindFirstChild(_G.Settings.AimPart)
                or p.Character:FindFirstChild("Head")

            local hrp = p.Character:FindFirstChild("HumanoidRootPart")

            if part
                and hrp
                and (Camera.CFrame.Position - hrp.Position).Magnitude
                    <= _G.Settings.MaxDistance then

                local s, on = Camera:WorldToViewportPoint(part.Position)

                if on then
                    local d = (
                        Vector2.new(s.X, s.Y) - center
                    ).Magnitude

                    if d < closest then
                        closest = d
                        target = part
                    end
                end
            end
        end
    end

    return target
end

-- ระบบยิงปืน
local function fireGun()
    if IsReloading then
        return
    end

    local tool = getEquippedTool()

    if tool then
        tool:Activate()

        VirtualUser:Button1Down(
            Vector2.new(0, 0),
            Camera.CFrame
        )

        task.wait(_G.Settings.FireRateVal)

        VirtualUser:Button1Up(
            Vector2.new(0, 0),
            Camera.CFrame
        )

        tool:Deactivate()
    end
end

_G.GetRainbow = GetRainbow
_G.isAlive = isAlive
_G.isTeammate = isTeammate
_G.getEquippedTool = getEquippedTool
_G.fireGun = fireGun
_G.GetClosestTarget = GetClosestTarget
_G.IsShootingBurst = IsShootingBurst
_G.LastShootTime = LastShootTime
