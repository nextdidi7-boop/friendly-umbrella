local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 2
FOVCircle.Filled    = false
FOVCircle.Color     = Color3.fromRGB(255,255,0)

local AimLine = Drawing.new("Line")
AimLine.Thickness = 2
AimLine.Color     = Color3.fromRGB(255,0,0)

local function UpdateHitbox()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            if char and isAlive(char) and not isTeammate(p) then
                local hrp  = char:FindFirstChild("HumanoidRootPart")
                local head = char:FindFirstChild("Head")

                if hrp then
                    if not OriginalSizes[hrp] then
                        OriginalSizes[hrp] = {
                            Size = hrp.Size,
                            Transparency = hrp.Transparency,
                            CanCollide = hrp.CanCollide
                        }
                    end
                    if HitboxEnabled then
                        hrp.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                        hrp.Transparency = 0.7
                        hrp.CanCollide = false
                    else
                        local o = OriginalSizes[hrp]
                        hrp.Size = o.Size
                        hrp.Transparency = o.Transparency
                        hrp.CanCollide = o.CanCollide
                    end
                end

                if head then
                    if not OriginalSizes[head] then
                        OriginalSizes[head] = {
                            Size = head.Size,
                            Transparency = head.Transparency,
                            CanCollide = head.CanCollide
                        }
                    end
                    if BigHeadEnabled then
                        head.Size = Vector3.new(BigHeadSize, BigHeadSize, BigHeadSize)
                        head.Transparency = 0.5
                        head.CanCollide = false
                    else
                        local o = OriginalSizes[head]
                        head.Size = o.Size
                        head.Transparency = o.Transparency
                        head.CanCollide = o.CanCollide
                    end
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(function()
    if HitboxEnabled or BigHeadEnabled then UpdateHitbox() end
end)

-- NPC ESP scanner
task.spawn(function()
    while task.wait(0.1) do
        if not ESP_NPC_ENABLED then
            for _, t in pairs(NPC_CACHE) do pcall(function() t:Remove() end) end
            NPC_CACHE = {}
        else
            local active = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid")
                    and not Players:GetPlayerFromCharacter(obj) then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                    if hum and hum.Health > 0 and hrp then
                        active[obj] = true
                        if not NPC_CACHE[obj] then
                            local t = Drawing.new("Text")
                            t.Center = true; t.Outline = true
                            t.Font = 2; t.Size = 13
                            t.Color = Color3.fromRGB(0, 255, 150)
                            NPC_CACHE[obj] = t
                        end
                        local pos, on = Camera:WorldToViewportPoint(hrp.Position)
                        if on then
                            NPC_CACHE[obj].Text = "[NPC] " .. obj.Name
                            NPC_CACHE[obj].Position = Vector2.new(pos.X, pos.Y - 20)
                            NPC_CACHE[obj].Visible = true
                        else
                            NPC_CACHE[obj].Visible = false
                        end
                    end
                end
            end
            for model, t in pairs(NPC_CACHE) do
                if not active[model] then
                    pcall(function() t:Remove() end)
                    NPC_CACHE[model] = nil
                end
            end
        end
    end
end)

local function joinLowPlayerServer()
    local api = "https://games.roblox.com/v1/games/" .. game.PlaceId
        .. "/servers/Public?sortOrder=Asc&limit=100"
    local ok, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(api))
    end)
    if ok and result and result.data then
        for _, s in ipairs(result.data) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                break
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    FOVCircle.Position = center
    FOVCircle.Radius   = FOV
    FOVCircle.Visible  = SilentAim or CAMERA_LOCK

    AimLine.Visible = false
    CurrentTarget = nil

    if SilentAim or CAMERA_LOCK or TriggerBot then
        CurrentTarget = select(1, getTarget())
    end

    if CAMERA_LOCK and CurrentTarget then
        cameraLookAtSmooth(CurrentTarget)
    end

    if SilentAim and not CAMERA_LOCK and CurrentTarget then
        local p = Camera:WorldToViewportPoint(CurrentTarget.Position)
        AimLine.From = center
        AimLine.To   = Vector2.new(p.X, p.Y)
        AimLine.Visible = true
    end

    -- TriggerBot
    if TriggerBot and CurrentTarget and tick() - LastTriggerTime > TriggerDelay then
        if getEquippedTool() then
            LastTriggerTime = tick()
            fireGun()
        end
    end

    -- Auto Shoot
    if AutoShootEnabled and CurrentTarget and getEquippedTool() then
        if tick() - LastShootTime >= FireRateVal then
            LastShootTime = tick()
            fireGun()
        end
    end

    -- Recoil / Spread
    local tool = getEquippedTool()
    if tool and (NoRecoil or NoSpread) then applyRecoilSpread(tool) end

    -- Auto Switch Target
    if AutoSwitchTarget and StickyTarget and not StickyTarget.Parent then
        StickyTarget = nil
    end

    -- ESP
    if ESP_ENABLED then
        for _, p in ipairs(Players:GetPlayers()) do
            local char = p.Character
            if p ~= LocalPlayer and char and isCharValid(char)
                and isAlive(char) and not isTeammate(p) then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                    if dist <= MaxDistance then
                        if not ESP_CACHE[char] then
                            local t = Drawing.new("Text")
                            t.Center = true; t.Outline = true
                            t.Font = 2; t.Size = 14
                            ESP_CACHE[char] = {Text = t}
                        end
                        local txt = ESP_CACHE[char].Text
                        local pos, on = Camera:WorldToViewportPoint(hrp.Position)
                        if on then
                            txt.Text = p.Name .. " [" .. math.floor(dist) .. "m]"
                            txt.Position = Vector2.new(pos.X, pos.Y - 28)
                            txt.Color = (CurrentTarget and CurrentTarget:IsDescendantOf(char))
                                and Color3.fromRGB(255,60,60)
                                or Color3.fromRGB(255,255,255)
                            txt.Visible = true
                        else
                            txt.Visible = false
                        end
                    else
                        if ESP_CACHE[char] then ESP_CACHE[char].Text.Visible = false end
                    end
                end
            else
                if char then clearESP(char) end
            end
        end
    else
        for c in pairs(ESP_CACHE) do clearESP(c) end
    end

    -- Rainbow ESP
    if RAINBOW_ESP then
        for _, p in ipairs(Players:GetPlayers()) do
            local char = p.Character
            if p ~= LocalPlayer and char and isCharValid(char)
                and isAlive(char) and not isTeammate(p) then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and (Camera.CFrame.Position - hrp.Position).Magnitude <= MaxDistance then
                    if not HIGHLIGHT_CACHE[char] then
                        local h = Instance.new("Highlight")
                        h.Adornee = char
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        h.FillTransparency = 1
                        h.OutlineTransparency = 0
                        h.Parent = workspace
                        HIGHLIGHT_CACHE[char] = h
                    end
                    HIGHLIGHT_CACHE[char].OutlineColor = rainbowColor(0.25)
                else
                    clearHighlight(char)
                end
            else
                if char then clearHighlight(char) end
            end
        end
    else
        for c in pairs(HIGHLIGHT_CACHE) do clearHighlight(c) end
    end

    -- Dodge
    if AutoDodge then doDodge() end

    -- WalkSpeed
    if WalkSpeedEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = WalkSpeedVal end
    end

    -- Fullbright
    if FullbrightEnabled then
        Lighting.Brightness = BrightnessVal
        Lighting.ClockTime  = 12
    end
end)
