-- TAB: AIM
-- ═══════════════════════════════════════════════════════

local AimTab = Window:Tab({Title = "Aim", Icon = "target"})

AimTab:Section({Title = "Aimbot"})
AimTab:Toggle({Title = "ล็อคหัว", Callback = function(v) CAMERA_LOCK = v end})
AimTab:Toggle({Title = "ล็อคกระสุน (Silent Aim)", Callback = function(v) SilentAim = v end})
AimTab:Dropdown({
    Title = "เลือกส่วนที่จะยิง",
    Values = {"ศีรษะ", "ลำตัว"},
    Default = "ศีรษะ",
    Callback = function(v) end
})
AimTab:Slider({
    Title = "ขนาด POV",
    Value = {Min = 40, Max = 4000, Default = FOV},
    Callback = function(v) FOV = v end
})
AimTab:Slider({
    Title = "ระยะล็อค",
    Value = {Min = 100, Max = 12000, Default = MaxDistance},
    Callback = function(v) MaxDistance = v end
})

AimTab:Section({Title = "Aim Behavior"})
AimTab:Slider({
    Title = "Aim Smoothness (นุ่ม = ค่าสูง)",
    Value = {Min = 0.05, Max = 1, Default = AimSmoothness},
    Step = 0.05,
    Callback = function(v) AimSmoothness = v end
})
AimTab:Toggle({
    Title = "Aim Prediction (ยิงล่วงหน้า)",
    Callback = function(v) AimPrediction = v end
})
AimTab:Slider({
    Title = "Prediction Amount",
    Value = {Min = 0.05, Max = 0.5, Default = PredictionAmount},
    Step = 0.01,
    Callback = function(v) PredictionAmount = v end
})
AimTab:Dropdown({
    Title = "Target Priority",
    Values = {"Closest", "LowestHP", "FacingMe"},
    Default = "Closest",
    Callback = function(v) TargetPriority = v end
})
AimTab:Toggle({
    Title = "Visible Check (ยิงเฉพาะที่มองเห็น)",
    Default = true,
    Callback = function(v) VisibleCheckOnly = v end
})
AimTab:Toggle({
    Title = "Wallbang (ยิงทะลุกำแพง)",
    Callback = function(v) WallbangEnabled = v end
})
AimTab:Toggle({
    Title = "Sticky Aim (ล็อคเป้าเดิมจนตาย)",
    Callback = function(v) StickyAim = v end
})
AimTab:Toggle({
    Title = "Team Check",
    Default = true,
    Callback = function(v) TeamCheck = v end
})

