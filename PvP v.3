-- HELPERS
-- ═══════════════════════════════════════════════════════

local function isAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isTeammate(p)
    if not TeamCheck then return false end
    if not LocalPlayer.Team or not p.Team then return false end
    return p.Team == LocalPlayer.Team
end

local function isCharValid(char)
    return char and char.Parent and char:IsDescendantOf(workspace)
end

local function rainbowColor(speed)
    return Color3.fromHSV((tick() * speed) % 1, 1, 1)
end

local function getEquippedTool()
    if LocalPlayer.Character then
        return LocalPlayer.Character:FindFirstChildOfClass("Tool")
    end
    return nil
end

local function notify(title, text, dur)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title, Text = text, Duration = dur or 3
        })
    end)
end

local function trackDrawing(d)
    if d then table.insert(DRAWINGS, d) end
    return d
end

-- ═══════════════════════════════════════════════════════
-- AIM ENGINE
-- ═══════════════════════════════════════════════════════

local RayParams = RaycastParams.new()
RayParams.FilterType  = Enum.RaycastFilterType.Blacklist
RayParams.IgnoreWater = true

local function isVisible(part, char)
    if not VisibleCheckOnly then return true end
    if WallbangEnabled then return true end
    RayParams.FilterDescendantsInstances = {LocalPlayer.Character, char}
    local origin = Camera.CFrame.Position
    local dir    = part.Position - origin
    return not workspace:Raycast(origin, dir, RayParams)
end

local function predictPosition(hrp, head)
    if not AimPrediction or not hrp then return head.Position end
    return head.Position + (hrp.AssemblyLinearVelocity * PredictionAmount)
end

local function facingMe(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not LocalPlayer.Character then return false end
    local myHrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false end
    local toMe = (myHrp.Position - hrp.Position).Unit
    return hrp.CFrame.LookVector:Dot(toMe) > 0.3
end

function getTarget()
    local now = tick()
    if now - LastTargetScan < 0.033 and CurrentTarget and CurrentTarget.Parent then
        return CurrentTarget, CurrentTargetData
    end
    LastTargetScan = now

    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local list = {}

    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if p ~= LocalPlayer and char and isAlive(char) and not isTeammate(p) then
            local aimPart = char:FindFirstChild(AimPart)
            local hrp     = char:FindFirstChild("HumanoidRootPart")
            if aimPart and hrp then
                local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                if dist <= MaxDistance then
                    local aimPos = predictPosition(hrp, aimPart)
                    local sp, on = Camera:WorldToViewportPoint(aimPos)
                    if on then
                        local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if sd < FOV then
                            local hum = char:FindFirstChildOfClass("Humanoid")
                            local vis = isVisible(aimPart, char)
                            if vis then
                                table.insert(list, {
                                    head = aimPart, hrp = hrp, player = p, char = char,
                                    dist = dist, screenDist = sd,
                                    hp = hum and hum.Health or math.huge,
                                    facing = facingMe(char),
                                    aimPos = aimPos, visible = vis
                                })
                            end
                        end
                    end
                end
            end
        end
    end

    if StickyAim and StickyTarget and StickyTarget.Parent then
        local hum = StickyTarget.Parent:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            for _, c in ipairs(list) do
                if c.head == StickyTarget then return c.head, c end
            end
        end
    end

    if #list == 0 then StickyTarget = nil; return nil, nil end

    if TargetPriority == "Closest" then
        table.sort(list, function(a,b) return a.dist < b.dist end)
    elseif TargetPriority == "LowestHP" then
        table.sort(list, function(a,b) return a.hp < b.hp end)
    elseif TargetPriority == "FacingMe" then
        table.sort(list, function(a,b)
            if a.facing ~= b.facing then return a.facing end
            return a.dist < b.dist
        end)
    end

    local best = list[1]
    StickyTarget = best.head
    return best.head, best
end

local function cameraLookAtSmooth(part)
    if not part then return end
    local goal = CFrame.new(Camera.CFrame.Position, part.Position)
    Camera.CFrame = Camera.CFrame:Lerp(goal, math.clamp(AimSmoothness, 0.05, 1))
end

local function clearHighlight(char)
    if HIGHLIGHT_CACHE[char] then
        pcall(function() HIGHLIGHT_CACHE[char]:Destroy() end)
        HIGHLIGHT_CACHE[char] = nil
    end
end

local function clearESP(char)
    local c = ESP_CACHE[char]
    if c then
        pcall(function()
            if c.Text then c.Text.Visible = false; c.Text:Remove() end
        end)
        ESP_CACHE[char] = nil
    end
    clearHighlight(char)
end
