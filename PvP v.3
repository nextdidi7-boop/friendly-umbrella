local AutoShootEnabled = false
local BurstTwoEnabled  = false
local GodModeEnabled   = false
local AutoReloadEnabled = false
local ReloadSpeedVal   = 0.2
local IsReloading      = false

-- Utility
local AntiFlinch    = false
local AntiStun      = false
local AutoDodge     = false
local DodgeRange    = 40
local HealthAlert   = false
local HealthAlertHP = 30
local KillNotifier  = false
local AutoRespawn   = false

-- Misc
local WalkSpeedVal     = 16
local WalkSpeedEnabled = false
local InfiniteJumpEnabled = false
local BrightnessVal    = 1
local FullbrightEnabled = false
local OriginalBrightness = Lighting.Brightness
local OriginalClockTime  = Lighting.ClockTime
local ESP_NPC_ENABLED = false
local HitboxEnabled   = false
local HitboxSize      = 10
local BigHeadEnabled  = false
local BigHeadSize     = 5

local CurrentTarget   = nil
local StickyTarget    = nil
local ESP_CACHE       = {}
local HIGHLIGHT_CACHE = {}
local NPC_CACHE       = {}
