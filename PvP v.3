-- ═══════════════════════════════════════════════════════
-- FIRING
-- ═══════════════════════════════════════════════════════

local function fireGun()
    if IsReloading then return end
    local tool = getEquippedTool()
    if tool then
        pcall(function() tool:Activate() end)
        task.wait(math.clamp(FireRateVal, 0.03, 1))
        pcall(function() tool:Deactivate() end)
    end
end

local function fastReload()
    if IsReloading then return end
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local tool = getEquippedTool()
    if not (hum and tool) then return end

    IsReloading = true
    ReloadToken = ReloadToken + 1
    local myToken = ReloadToken

    task.spawn(function()
        task.wait(ReloadSpeedVal)
        if myToken ~= ReloadToken then IsReloading = false; return end
        pcall(function() hum:UnequipTools() end)
        task.wait(0.05)
        if myToken ~= ReloadToken then IsReloading = false; return end
        if tool.Parent then
            pcall(function() hum:EquipTool(tool) end)
        end
        IsReloading = false
    end)
end

local function handleAutoReload()
    if not AutoReloadEnabled or IsReloading then return end
    local tool = getEquippedTool()
    if tool then
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("IntValue") or v:IsA("NumberValue") then
                local n = v.Name:lower()
                if (n:find("ammo") or n:find("clip") or n:find("bullet")) and v.Value <= 0 then
                    fastReload(); break
                end
            end
        end
    end
end

-- ═══════════════════════════════════════════════════════
-- NO RECOIL / NO SPREAD HOOK
-- ═══════════════════════════════════════════════════════

local function hookTool(tool)
    if not tool or HookedTools[tool] then return end
    HookedTools[tool] = {recoil = {}, spread = {}}
    for _, v in ipairs(tool:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            local n = v.Name:lower()
            if n:find("recoil") or n:find("kick") or n:find("camera") then
                HookedTools[tool].recoil[v] = v.Value
            elseif n:find("spread") or n:find("accuracy") or n:find("deviation") then
                HookedTools[tool].spread[v] = v.Value
            end
        end
    end
end

local function applyRecoilSpread(tool)
    if not tool then return end
    if not HookedTools[tool] then hookTool(tool) end
    local data = HookedTools[tool]
    if not data then return end

    if NoRecoil then
        for v in pairs(data.recoil) do
            if v.Parent then pcall(function() v.Value = 0 end) end
        end
    else
        for v, orig in pairs(data.recoil) do
            if v.Parent then pcall(function() v.Value = orig end) end
        end
    end

    if NoSpread then
        for v in pairs(data.spread) do
            if v.Parent then pcall(function() v.Value = 0 end) end
        end
    else
        for v, orig in pairs(data.spread) do
            if v.Parent then pcall(function() v.Value = orig end) end
        end
    end
end

local function handleAutoScope()
    if not AutoScope then return end
    local tool = getEquippedTool()
    if not tool then return end
    for _, v in ipairs(tool:GetDescendants()) do
        if v:IsA("BoolValue") then
            local n = v.Name:lower()
            if n:find("scope") or n:find("zoom") or n:find("aim") then
                if not v.Value then v.Value = true end
            end
        end
    end
end

-- ═══════════════════════════════════════════════════════
-- UTILITY
-- ═══════════════════════════════════════════════════════

local function applyAntiFlinch(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local on = AntiFlinch
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,    not on)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,        not on)
        hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, not on)
    end)
end

local function applyAntiStun(char)
    if not AntiStun then return end
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if hum.WalkSpeed < WalkSpeedVal then hum.WalkSpeed = WalkSpeedVal end
    if (hum.JumpPower or 0) < 50 then hum.JumpPower = 50 end
end

local function doDodge()
    if not AutoDodge or tick() - LastDodgeTime < 0.4 then return end
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not isTeammate(p) then
            local ehrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if ehrp and (ehrp.Position - hrp.Position).Magnitude < DodgeRange then
                local dir  = (hrp.Position - ehrp.Position).Unit
                local side = Vector3.new(-dir.Z, 0, dir.X)
                local move = side * (math.random() > 0.5 and 1 or -1)
                hrp.CFrame = hrp.CFrame + move * 4
                LastDodgeTime = tick()
                return
            end
        end
    end
end

local function setupCharUtility(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 3)
    if not hum then return end

    applyAntiFlinch(char)

    hum.HealthChanged:Connect(function(hp)
        if HealthAlert and hp <= HealthAlertHP and hp > 0 then
            notify("HP ต่ำ!", "HP: " .. math.floor(hp), 2)
        end
        if AutoReturnFire and getEquippedTool() and CurrentTarget then
            if tick() - LastReturnFire > 0.15 then
                LastReturnFire = tick()
                task.spawn(fireGun)
            end
        end
    end)

    hum.Died:Connect(function()
        if AutoRespawn then
            task.wait(0.5)
            pcall(function() LocalPlayer:LoadCharacter() end)
        end
    end)
end

local function watchKills()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and not WatchedHumans[hum] then
                WatchedHumans[hum] = true
                hum.Died:Connect(function()
                    WatchedHumans[hum] = nil
                    if not KillNotifier then return end
                    local killer = hum:FindFirstChild("creator")
                    if killer and killer.Value == LocalPlayer then
                        notify("KILL", "You killed " .. p.Name, 2)
                    end
                end)
            end
        end
    end
end

if LocalPlayer.Character then setupCharUtility(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(c)
    setupCharUtility(c)
    task.wait(1)
    watchKills()
end)
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function() task.wait(1); watchKills() end)
end)
watchKills()

Players.PlayerRemoving:Connect(function(p)
    local char = p.Character
    if char then
        for _, d in ipairs(char:GetDescendants()) do
            OriginalSizes[d] = nil
        end
    end
end)

UserInputService.JumpRequest:Connect(function()
    if InfiniteJumpEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        and BurstTwoEnabled and not IsShootingBurst then
        local tool = getEquippedTool()
        if tool then
            IsShootingBurst = true
            task.spawn(function()
                fireGun()
                task.wait(0.08)
                fireGun()
                IsShootingBurst = false
            end)
        end
    end
end)

local function scanTools(char)
    if not char then return end
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Tool") then hookTool(c) end
    end
    char.ChildAdded:Connect(function(c)
        if c:IsA("Tool") then task.wait(0.1); hookTool(c) end
    end)
end
if LocalPlayer.Character then scanTools(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(scanTools)

RunService.Stepped:Connect(function()
    if GodModeEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = hum.MaxHealth end
    end
    handleAutoReload()
    handleAutoScope()
    applyAntiStun(LocalPlayer.Character)
end)
