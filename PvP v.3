-- NEW: full player ESP (box + health + name + distance)
local function ESP_FULL_SYSTEM()
    for _,p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if p ~= LocalPlayer and char and isCharValid(char) and isAlive(char) and not isTeammate(p) then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then clearESP(char) continue end

            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            if dist > MaxDistance then
                if ESP_CACHE[char] then
                    for _,o in pairs(ESP_CACHE[char]) do o.Visible = false end
                end
                continue
            end

            if not ESP_CACHE[char] then
                local box = Drawing.new("Square")
                box.Thickness = 1
                box.Filled = false
                box.Color = Color3.fromRGB(255, 255, 255)

                local name = Drawing.new("Text")
                name.Center = true
                name.Outline = true
                name.Font = 2
                name.Size = 14
                name.Color = Color3.fromRGB(255, 255, 255)

                local hp = Drawing.new("Text")
                hp.Center = true
                hp.Outline = true
                hp.Font = 2
                hp.Size = 12
                hp.Color = Color3.fromRGB(0, 255, 0)

                local tr = Drawing.new("Line")
                tr.Thickness = 1
                tr.Color = Color3.fromRGB(255, 200, 0)

                ESP_CACHE[char] = {Box = box, Name = name, HP = hp, Tracer = tr}
            end

            local cache = ESP_CACHE[char]
            local head = char:FindFirstChild("Head")
            local top = head and head.Position + Vector3.new(0, 1.2, 0) or hrp.Position + Vector3.new(0, 2.5, 0)
            local bottom = hrp.Position - Vector3.new(0, 3, 0)
            local sTop, onTop = Camera:WorldToViewportPoint(top)
            local sBot, onBot = Camera:WorldToViewportPoint(bottom)

            if onTop and onBot then
                local h = math.abs(sBot.Y - sTop.Y)
                local w = h * 0.55

                cache.Box.Size = Vector2.new(w, h)
                cache.Box.Position = Vector2.new(sTop.X - w/2, sTop.Y)
                cache.Box.Color = (CurrentTarget and CurrentTarget:IsDescendantOf(char)) and Color3.fromRGB(255,60,60) or Color3.fromRGB(255,255,255)
                cache.Box.Visible = BoxESPEnabled

                cache.Name.Text = p.Name
                cache.Name.Position = Vector2.new(sTop.X, sTop.Y - 18)
                cache.Name.Visible = NameESPEnabled

                local pct = hum.Health / hum.MaxHealth
                cache.HP.Text = string.format("%d / %d", math.floor(hum.Health), math.floor(hum.MaxHealth))
                cache.HP.Position = Vector2.new(sTop.X, sBot.Y + 4)
                cache.HP.Color = Color3.fromRGB(255*(1-pct), 255*pct, 0)
                cache.HP.Visible = HealthESPEnabled

                if TracerEnabled then
                    local cp = Camera.ViewportSize / 2
                    cache.Tracer.From = Vector2.new(cp.X, Camera.ViewportSize.Y)
                    cache.Tracer.To = Vector2.new(sTop.X, sBot.Y)
                    cache.Tracer.Visible = true
                else
                    cache.Tracer.Visible = false
                end
            else
                for _,o in pairs(cache) do o.Visible = false end
            end
        else
            if char then clearESP(char) end
        end
    end
end

