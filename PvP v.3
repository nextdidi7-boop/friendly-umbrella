local FOV          = 120

-- Aim extras
local AimSmoothness    = 0.25
local AimPrediction    = false
local PredictionAmount = 0.15
local TargetPriority   = "Closest"
local VisibleCheckOnly = true
local WallbangEnabled  = false
local StickyAim        = false

-- Gun extras
