track(UIS.InputBegan:Connect(function(input, processed)
    if not isRunning or UIS:GetFocusedTextBox() then return end
    if capturingLockKey or capturingSnapKey or capturingVehicleKey then
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
            if capturingVehicleKey then
                local blocked = input.KeyCode == AimConfig.LockKey or input.KeyCode == SnapConfig.Key
                    or input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.A
                    or input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.D
                    or input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.E
                    or input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift
                if blocked then
                    status.VehicleKeyError = "Key in use - choose another"
                    if refreshControls then refreshControls() end
                    return
                end
                VehicleConfig.UndergroundKey = input.KeyCode
                status.VehicleKeyError = nil
            elseif capturingSnapKey then
                if input.KeyCode ~= AimConfig.LockKey and input.KeyCode ~= VehicleConfig.UndergroundKey then SnapConfig.Key = input.KeyCode end
            elseif input.KeyCode ~= SnapConfig.Key and input.KeyCode ~= VehicleConfig.UndergroundKey then
                AimConfig.LockKey = input.KeyCode
            end
        end
        capturingLockKey = false
        capturingSnapKey = false
        capturingVehicleKey = false
        if refreshControls then refreshControls() end
        return
    end
    if processed then return end
    if input.KeyCode == VehicleConfig.UndergroundKey then
        if toggleVehicleUnderground then toggleVehicleUnderground() end
        return
    end
    if input.KeyCode == SnapConfig.Key then
        if toggleSnap then toggleSnap() end
        return
    end
    if input.KeyCode == AimConfig.LockKey then setAimLockEnabled(not aimLockEnabled) end
end))
