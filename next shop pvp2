local function SafeCall(func, ...) local success, res = pcall(func, ...) return success, res end
local unpackFunc = table.unpack or unpack

local function CallRemote(remote, ...)
    if not remote then return end
    local args = {...}
    if remote.ClassName == "RemoteEvent" then
        if aC and type(aC.event) == "number" then
            aC.event = aC.event + 1
            SafeCall(function(...) remote:FireServer(aC.event, ...) end, unpackFunc(args))
        else
            aq = (aq or 0) + 1
            SafeCall(function(...) remote:FireServer(aq, ...) end, unpackFunc(args))
        end
    elseif remote.ClassName == "RemoteFunction" then
        if aC and type(aC.func) == "number" then
            aC.func = aC.func + 1
            SafeCall(function(...) remote:InvokeServer(aC.func, ...) end, unpackFunc(args))
        else
            ar = (ar or 0) + 1
            SafeCall(function(...) remote:InvokeServer(ar, ...) end, unpackFunc(args))
        end
    end
end

local function getPlayersInRange(range)
    local list = {}
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return list end
    local rootPos = char.PrimaryPart.Position
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character.PrimaryPart then
            local success, dist = pcall(function() return (p.Character.PrimaryPart.Position - rootPos).Magnitude end)
            if success and dist and dist <= range then table.insert(list, p) end
        end
    end
    return list
end

