        end
    end
    return nil
end

local function isMeleeTool(tool)
    if not tool then return false end
    if tool.Name == "Fists" then return true end
    local itemsFolder = ReplicatedStorage:FindFirstChild("Items")
    if itemsFolder then
        local meleeFolder = itemsFolder:FindFirstChild("melee")
        local throwFolder = itemsFolder:FindFirstChild("throwable")
        if meleeFolder and meleeFolder:FindFirstChild(tool.Name) and not (throwFolder and throwFolder:FindFirstChild(tool.Name)) then
            return true
        end
    end
    return false
end
