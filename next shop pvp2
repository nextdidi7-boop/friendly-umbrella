-- ตัวอย่างแท็บ Vehicle
vehicleTab:Section({Title = "Vehicle Controls"})
vehicleTab:Button({
    Title = "Pull Car Owner",
    Desc = "ดึงรถของฉันมาหาตัว",
    Callback = function()
        local vehicles = workspace:WaitForChild("Vehicles", 2)
        if vehicles then
            for _, vehicle in pairs(vehicles:GetChildren()) do
                if vehicle:IsA("Model") and vehicle:GetAttribute("OwnerUserId") == localPlayer.UserId then
                    local rootPart = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if rootPart and vehicle.PrimaryPart then
                        vehicle:SetPrimaryPartCFrame(rootPart.CFrame * CFrame.new(0, 3, -5))
                    end
                end
            end
        end
    end
})

