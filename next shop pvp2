local function createESP(p)
    if ESPTable[p] then return end
    local txtName = Drawing.new("Text")
    txtName.Size = 16; txtName.Center = true; txtName.Outline = true; txtName.Color = Color3.fromRGB(255,255,255); txtName.Font = 4
    local txtDist = Drawing.new("Text")
    txtDist.Size = 14; txtDist.Center = true; txtDist.Outline = true; txtDist.Color = Color3.fromRGB(255,255,255); txtDist.Font = 4
    local drawings = {txtName, txtDist}
    
    local conn = RunService.RenderStepped:Connect(function()
        if not p or not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then
            for _, d in pairs(drawings) do d.Visible = false end
            return
        end
        local hrp = p.Character.HumanoidRootPart
        local dist = 0
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            dist = (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
        end
        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen or screenPos.Z <= 0 then
            for _, d in pairs(drawings) do d.Visible = false end
            return
        end
        if M then
            txtName.Text = p.Name
            txtName.Position = Vector2.new(screenPos.X, screenPos.Y - 15)
            txtName.Visible = true
        else
            txtName.Visible = false
        end
        if N then
            txtDist.Text = string.format("%.0f studs", dist)
            txtDist.Position = Vector2.new(screenPos.X, screenPos.Y + 10)
            txtDist.Visible = true
        else
            txtDist.Visible = false
        end
    end)
    ESPTable[p] = {conn = conn, drawings = drawings}
end

