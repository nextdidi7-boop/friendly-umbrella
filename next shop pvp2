                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                    local dist = (screenVec - center).Magnitude
                    if dist <= H and not isPlayerExcluded(p.Name) then
                        if dist < shortestDist then shortestDist = dist target = p end
                    end
                end
            end
        end
    end
    return target
end

local function predictPosition(targetPart, targetHRP)
    if not targetPart then return Vector3.zero end
    local ping = (getPing and getPing()) or 0.2
    if ping > 1 then ping = ping + 0.15 end
    local vel = (targetHRP and targetHRP.AssemblyLinearVelocity) or Vector3.zero
    return targetPart.Position + (vel * ping * 1)
end

local function isBehindWall(startPos, endPos)
    if not startPos or not endPos then return false end
    local dir = endPos - startPos
    if dir.Magnitude < 1 then return false end
    local ignoreList = {}
    if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
    local raycastResult = Workspace:Raycast(startPos, dir, RaycastParams.new())
    if not raycastResult then return false end
    local hitInst = raycastResult.Instance
    return hitInst and not table.find(ignoreList, hitInst.Parent)
end

