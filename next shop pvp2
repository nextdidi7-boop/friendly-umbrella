local function getPing()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return 0.2 end
    local netStats = playerGui:FindFirstChild("NetworkStats")
    if not netStats then return 0.2 end
    local pingLabel = netStats:FindFirstChild("PingLabel")
    if not pingLabel then return 0.2 end
    local pingText = pingLabel.Text
    if typeof(pingText) ~= "string" then return 0.2 end
    local pingNum = tonumber(pingText:match("%d+"))
    if not pingNum then return 0.2 end
    local pingSec = pingNum / 1000
    if pingSec < 0 or pingSec > 2 then pingSec = 0.2 end
    return pingSec
end

local function isPlayerExcluded(name)
    for _, exc in ipairs(P) do
        if exc ~= "" and string.find(string.lower(name), string.lower(exc)) then return true end
    end
    return false
end
